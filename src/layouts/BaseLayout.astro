---
// One layout, every page. Owns the <head> (SEO), the shared chrome, and the
// JSON-LD slot. A new page just picks this layout and passes props — the SEO
// furniture is never rewritten per page.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import CookieConsent from '../components/CookieConsent.astro';
import LangSuggest from '../components/LangSuggest.astro';
import DIMS from '../data/image-dims.json';
import '../styles/global.css';

const {
  lang = 'en',
  title,
  description,
  canonical,       // absolute path, e.g. '/about'
  ogImage = '/images/lena-filatova-womens-health-coach-over-40.jpg',
  // OPS-300: alt text for the share image. Facebook and LinkedIn read it for
  // screen-reader users on the preview card, and it is the one piece of the
  // og:image set that cannot be derived — blog posts and recipes already carry
  // per-language alt text for their hero, so they pass it through.
  ogImageAlt,
  ogType = 'website',
  // OPS-300: article:published_time / article:modified_time. Only meaningful
  // when ogType === 'article'; a page that has no dates simply omits them.
  // ISO date (YYYY-MM-DD) is a valid value — the spec wants ISO 8601 and a
  // date without a time is ISO 8601.
  publishedTime,
  modifiedTime,
  jsonld,          // optional object → <script type="application/ld+json">
  showList = false, // recipe pages: show the shopping-list button in the header
  enHref, uaHref,   // recipe pages: where the EN/UA toggle points
  alternates,      // optional {en, ua} site-absolute paths → hreflang links
                   // (en + uk + ru→ua; x-default = en)
  noindex = false, // hidden pages (e.g. shop while nothing is on sale)
  readingProgress = false, // long-read pages (blog posts): thin scroll indicator on top
  revealOnScroll = false, // homepage: fade sections up as they come into view
  // Newsletter band above the footer. On by default so every page has a signup
  // form and the header's Subscribe button always has a #newsletter to jump to.
  // The homepage sets false — HomeBody renders its own in the page flow, and two
  // per page would make the anchor ambiguous.
  newsletter = true,
} = Astro.props;

// The site is `trailingSlash: 'always'`, so /about is a 301 to /about/ — and a
// canonical (or hreflang) pointing at a redirect is a canonical Google either
// ignores or, as it did here, honours by indexing the redirecting URL instead
// of the real one (OPS-289: /about/ sat in Search Console as "Alternative page
// with proper canonical tag" while /about — the 301 — was the indexed URL).
// Normalising here rather than only at the 16 call sites means a new page that
// passes canonical="/foo" can't quietly reintroduce it.
const slashed = (p) => (p.endsWith('/') ? p : p + '/');
const canonicalUrl = new URL(slashed(canonical), Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const altEn = alternates && new URL(slashed(alternates.en), Astro.site).href;
const altUa = alternates && new URL(slashed(alternates.ua), Astro.site).href;
// X/Twitter renders `summary_large_image` as a wide ~1.91:1 banner and `summary`
// as a small square thumbnail. Picking the wrong one is visible damage: a
// portrait photo in a wide card is cropped to a band across the subject's
// middle. Our images are genuinely mixed — blog heroes are 16:9, but the
// default profile photo is 9:16 and ~40 recipe photos are portrait or square —
// so the card has to follow the image rather than be hard-coded. The intrinsic
// sizes already kept for layout stability answer that; anything not in the
// manifest (a hero photo not supplied yet) falls back to the safe square card.
const ogDim = DIMS[ogImage];
const twitterCard = ogDim && ogDim.w / ogDim.h >= 1.4 ? 'summary_large_image' : 'summary';
// OPS-300: og:locale is a POSIX-style locale, not a bare language code, and the
// site is written in British English rather than American. The alternate is
// only declared where an alternate page actually exists — the same condition
// that governs hreflang above, so the two can never disagree.
const OG_LOCALE = { en: 'en_GB', ua: 'uk_UA' };
const ogLocale = OG_LOCALE[lang] || OG_LOCALE.en;
const ogLocaleAlt = lang === 'ua' ? OG_LOCALE.en : OG_LOCALE.ua;
// Preview deploys (base != '/') must never be indexed — they'd compete with
// the live domain. Flips off automatically when `base` is dropped at cutover.
const isPreview = import.meta.env.BASE_URL !== '/';
const B = import.meta.env.BASE_URL;
const FAVICON = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Ccircle cx='20' cy='20' r='20' fill='%23B23A63'/%3E%3Ctext x='20' y='27' font-family='Georgia,serif' font-style='italic' font-size='20' fill='%23F6F0F5' text-anchor='middle'%3Elf%3C/text%3E%3C/svg%3E";
---
<!doctype html>
<html lang={lang === 'ua' ? 'uk' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(isPreview || noindex) && <meta name="robots" content="noindex" />}
    {/* OPS-300: brand magenta (--accent in global.css) in the mobile browser
        chrome — Chrome on Android and Safari on iOS tint the address bar with
        it. Hard-coded because <meta> cannot read a CSS custom property; if the
        accent changes in global.css, change it here too. */}
    <meta name="theme-color" content="#B23A63" />
    <link rel="icon" href={FAVICON} />
    <link rel="apple-touch-icon" href={`${B}images/apple-touch-icon.png`} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates && <link rel="alternate" hreflang="en" href={altEn} />}
    {alternates && <link rel="alternate" hreflang="uk" href={altUa} />}
    {/* Russian-language searchers get the Ukrainian page, not the English one.
        A real share of the site's search demand arrives in Russian — "черничный
        джем без сахара", "морковный кекс без сахара" — and those people matched
        neither `en` nor `uk`, so Google fell through to x-default and served
        them English: the one language of the three they were least likely to
        read. Ukrainian is much closer to a Russian reader than English is.

        This is a deliberate misdeclaration and worth knowing as one: hreflang
        is meant to name the language the target page is written in, and that
        page is Ukrainian. What it says here is "for a Russian-speaking user,
        this is the right page", which is the outcome we want and a mapping
        Google tolerates. It may also be ignored — hreflang is a hint, not an
        instruction, so treat it as improving the odds rather than as a switch.

        x-default deliberately stays on English: it catches every *other*
        unmatched language, and a German or Polish speaker is not better served
        in Ukrainian. */}
    {alternates && <link rel="alternate" hreflang="ru" href={altUa} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={altEn} />}
    {/* Feed discovery (OPS-213) — each language advertises its own feed. */}
    <link rel="alternate" type="application/rss+xml"
          title={lang === 'ua' ? 'Lena Filatova — Журнал' : 'Lena Filatova — Journal'}
          href={lang === 'ua' ? `${B}ua/rss.xml` : `${B}rss.xml`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    {/* OPS-300: the intrinsic size is already known here — it is what picks the
        Twitter card type below — so declaring it costs nothing and lets a
        scraper reserve the right box instead of reflowing the preview once the
        image arrives. Anything not in the manifest (a hero photo Lena has not
        supplied yet) simply omits the pair rather than guessing. */}
    {ogDim && <meta property="og:image:width" content={String(ogDim.w)} />}
    {ogDim && <meta property="og:image:height" content={String(ogDim.h)} />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:site_name" content="Lena Filatova" />
    <meta property="og:locale" content={ogLocale} />
    {alternates && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {/* No twitter:site / twitter:creator. The OPS-300 brief asked for them, but
        there is no X account for the brand or for Lena — SOCIALS in site.js is
        Instagram and Facebook. Both tags take an @handle and an invented or
        wrong one is worse than none, so they stay out until an account exists. */}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {/* Fonts are self-hosted (OPS-211) — the @font-face rules live at the top of
        global.css, which Astro bundles into the stylesheet this page already
        loads. That removes the render-blocking Google Fonts stylesheet and the
        preconnects to its two origins entirely.
        The body font is still worth preloading: the browser only discovers a
        @font-face src after the CSS has downloaded and parsed, so preloading
        starts the fetch in parallel. Manrope is a variable font, so one file
        per subset covers all four weights (400/500/600/700). Latin is needed
        everywhere (digits, brand names); Cyrillic only on the UA pages.
        `crossorigin` is required on a font preload even same-origin — without
        it the browser fetches the file twice. Spectral is heading-only, so it
        is left to normal CSS discovery rather than competing for bandwidth. */}
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href={`${B}fonts/manrope-latin-var.woff2`} />
    {lang === 'ua' && (
      <link rel="preload" as="font" type="font/woff2" crossorigin
            href={`${B}fonts/manrope-cyrillic-var.woff2`} />
    )}
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    {revealOnScroll && (
      /* The reveal CSS hides .reveal behind this class, so the class has to be
         set here — in <head>, before the body paints — or the sections flash in
         at full opacity and then jump back down to be animated. Equally, it
         must only be set when the observer below can actually run: no
         IntersectionObserver means no .reveal-js, which means no hidden state,
         rather than a permanently blank homepage. */
      <script is:inline>
        if ('IntersectionObserver' in window) document.documentElement.classList.add('reveal-js');
      </script>
    )}
  </head>
  <body>
    {/* Offer the Ukrainian page to a Ukrainian- or Russian-language browser that
        landed on the English one (OPS-369). Above the masthead so it scrolls
        away — it is an offer made once, not chrome. English pages only: the
        Ukrainian page has nothing to suggest. */}
    {alternates && lang === 'en' && <LangSuggest uaHref={`${B.replace(/\/$/, '')}${slashed(alternates.ua)}`} />}
    {readingProgress && <div class="reading-progress" id="readingProgress" aria-hidden="true" hidden></div>}
    <Header lang={lang} showList={showList} enHref={enHref} uaHref={uaHref} />
    <main><slot /></main>
    {newsletter && <Newsletter lang={lang} />}
    <Footer lang={lang} />
    <CookieConsent lang={lang} />
    {revealOnScroll && (
      <script is:inline>
        (function () {
          var els = document.querySelectorAll('.reveal');
          if (!els.length) return;

          function showAll() {
            for (var i = 0; i < els.length; i++) els[i].classList.add('is-visible');
          }
          // The CSS keeps everything visible under reduced motion anyway; this
          // just stops us observing scroll for an effect nobody will see.
          if (!window.IntersectionObserver ||
              (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)) {
            showAll();
            return;
          }

          var remaining = els.length;
          function show(el) {
            if (el.classList.contains('is-visible')) return;
            el.classList.add('is-visible');
            remaining--;
          }

          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              show(e.target);
              // One-way: re-hiding on the way back up makes scrolling feel
              // broken, and it would replay the stagger every pass.
              io.unobserve(e.target);
            });
          }, {
            // Start the fade a little before the section's edge reaches the
            // fold, so it has finished by the time it is properly in view.
            rootMargin: '0px 0px -12% 0px',
            threshold: 0.05,
          });

          for (var i = 0; i < els.length; i++) io.observe(els[i]);

          // Safety sweep on the same trigger line as the observer above.
          //
          // This is not just for the section already on screen at first paint
          // (which may never produce an intersection *change*) — it means a
          // section can never be stranded at opacity 0 even if the observer
          // fails to deliver, which is the one failure here that would cost a
          // visitor the content rather than just the animation. It detaches as
          // soon as everything is shown, so once the page has been read through
          // it costs nothing.
          var ticking = false;
          function sweep() {
            ticking = false;
            for (var i = 0; i < els.length; i++) {
              var r = els[i].getBoundingClientRect();
              if (r.top < innerHeight * 0.88 && r.bottom > 0) show(els[i]);
            }
            if (remaining <= 0) {
              window.removeEventListener('scroll', onScroll);
              window.removeEventListener('resize', onScroll);
            }
          }
          function onScroll() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(sweep);
          }
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
          window.addEventListener('load', sweep);
          sweep();
        })();
      </script>
    )}
    {readingProgress && (
      <script is:inline>
        (function () {
          var bar = document.getElementById('readingProgress');
          if (!bar) return;
          var max = 0;
          var ticking = false;

          // documentElement, not body: <html> is the scrolling element in
          // standards mode, so its scrollHeight is what scrollY runs against.
          function measure() {
            max = document.documentElement.scrollHeight - window.innerHeight;
            // A post shorter than the viewport can never scroll — a bar pinned
            // at 0% (or NaN%) would just be furniture, so hide it outright.
            bar.hidden = max <= 0;
          }

          function paint() {
            ticking = false;
            if (max <= 0) return;
            var pct = (window.scrollY / max) * 100;
            bar.style.width = (pct < 0 ? 0 : pct > 100 ? 100 : pct) + '%';
          }

          // One write per frame — scroll fires far faster than the compositor.
          function onScroll() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(paint);
          }

          function remeasure() { measure(); paint(); }

          remeasure();
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', remeasure);
          // Webfonts and the cookie banner land after parse and shift the height.
          window.addEventListener('load', remeasure);
          // Article images are loading="lazy", so the page keeps growing as you
          // read it. Measuring once would make the bar hit 100% before the real
          // bottom, so track the document height for as long as it changes.
          if (window.ResizeObserver) {
            new ResizeObserver(remeasure).observe(document.documentElement);
          }
        })();
      </script>
    )}
  </body>
</html>

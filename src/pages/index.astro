---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBody from '../components/HomeBody.astro';
import { HOME } from '../data/site.js';
const t = HOME.en;
---
<BaseLayout lang="en" title={t.seoTitle} description={t.seoDesc} canonical="/" alternates={{ en: "/", ua: "/ua/" }} revealOnScroll>
  <HomeBody lang="en" />
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TagPageBody from '../../../components/TagPageBody.astro';
import { POSTS } from '../../../data/blog.js';
import { resolveTags, tagJsonLd, tagPath, UI, MIN_INDEXABLE } from '../../../data/tags-lib.js';

export function getStaticPaths() {
  return resolveTags(POSTS).map((tag) => ({ params: { tag: tag.key }, props: { tag } }));
}

const { tag } = Astro.props;
const t = UI.en;
const B = import.meta.env.BASE_URL;
const label = tag.en;
---
<BaseLayout
  lang="en"
  title={`${label} — Lena Filatova`}
  description={tag.intro?.en || t.metaDesc(label, tag.count)}
  canonical={tagPath('en', tag.key)}
  ogImage={tag.resolved[0].image}
  jsonld={tagJsonLd(tag, 'en', t)}
  alternates={{ en: tagPath('en', tag.key), ua: tagPath('ua', tag.key) }}
  noindex={tag.count < MIN_INDEXABLE}
  enHref={`${B.replace(/\/$/, '')}${tagPath('en', tag.key)}`}
  uaHref={`${B.replace(/\/$/, '')}${tagPath('ua', tag.key)}`}>
  <TagPageBody tag={tag} lang="en" />
</BaseLayout>

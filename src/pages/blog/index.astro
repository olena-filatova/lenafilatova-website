---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogHubBody from '../../components/BlogHubBody.astro';
import { POSTS } from '../../data/blog.js';
import { langUrl } from '../../data/blog-lib.js';
import { hubJsonLd, SITE } from '../../data/schema-lib.js';
const B = import.meta.env.BASE_URL;
// OPS-301: the Journal index carried no structured data at all. Mirrors
// BlogHubBody's own listing rule — `filedUnder: 'tools'` posts live on the
// Tools & guides page, so they are not Journal entries here either.
const listed = POSTS
  .filter((p) => p.filedUnder !== 'tools')
  .sort((a, b) => b.date.localeCompare(a.date));
const jsonld = hubJsonLd({
  lang: 'en',
  name: "Journal",
  description: "Research-backed articles on diabetes, perimenopause, nutrition, skin and weight.",
  url: `${SITE}/blog/`,
  crumb: "Journal",
  items: listed.map((p) => ({ name: p['en'].title, url: langUrl('en', p.slug) })),
});
---
<BaseLayout
  lang="en" jsonld={jsonld}
  title="Blog — evidence-based women's health after 40"
  description="Research-backed articles on diabetes, perimenopause, nutrition, skin and weight — written by Lena Filatova, living with type 1 diabetes for 23 years."
  canonical="/blog/"
  alternates={{ en: '/blog/', ua: '/ua/blog/' }}
  enHref={`${B}blog/`}
  uaHref={`${B}ua/blog/`}>
  <BlogHubBody lang="en" />
</BaseLayout>

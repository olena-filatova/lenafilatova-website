---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostBody from '../../components/BlogPostBody.astro';
import { POSTS } from '../../data/blog.js';
import { buildJsonLd, seoTitleOf, hasHero } from '../../data/blog-lib.js';
import DIMS from '../../data/image-dims.json';

export function getStaticPaths() {
  return POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const B = import.meta.env.BASE_URL;
const a = post.en;
---
<BaseLayout
  lang="en"
  title={seoTitleOf(a)}
  description={a.metaDesc || a.excerpt}
  canonical={`/blog/${post.slug}/`}
  ogImage={hasHero(post, DIMS) ? post.image : undefined}
  ogImageAlt={hasHero(post, DIMS) ? a.imageAlt : undefined}
  ogType="article"
  publishedTime={post.date}
  modifiedTime={post.updated || post.date}
  jsonld={buildJsonLd(post, 'en', DIMS)}
  alternates={{ en: `/blog/${post.slug}/`, ua: `/ua/blog/${post.slug}/` }}
  readingProgress
  enHref={`${B}blog/${post.slug}/`}
  uaHref={`${B}ua/blog/${post.slug}/`}>
  <BlogPostBody post={post} lang="en" />
</BaseLayout>

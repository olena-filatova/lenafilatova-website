---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogPostBody from '../../../components/BlogPostBody.astro';
import { POSTS } from '../../../data/blog.js';
import { buildJsonLd, seoTitleOf } from '../../../data/blog-lib.js';

export function getStaticPaths() {
  return POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const B = import.meta.env.BASE_URL;
const a = post.ua;
---
<BaseLayout
  lang="ua"
  title={seoTitleOf(a)}
  description={a.metaDesc || a.excerpt}
  canonical={`/ua/blog/${post.slug}/`}
  ogImage={post.image}
  ogImageAlt={a.imageAlt}
  ogType="article"
  publishedTime={post.date}
  modifiedTime={post.updated || post.date}
  jsonld={buildJsonLd(post, 'ua')}
  alternates={{ en: `/blog/${post.slug}/`, ua: `/ua/blog/${post.slug}/` }}
  readingProgress
  enHref={`${B}blog/${post.slug}/`}
  uaHref={`${B}ua/blog/${post.slug}/`}>
  <BlogPostBody post={post} lang="ua" />
</BaseLayout>

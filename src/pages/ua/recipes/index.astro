---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RecipeHubBody from '../../../components/RecipeHubBody.astro';
import { PUBLISHED } from '../../../data/recipes.js';
import { hubJsonLd, SITE } from '../../../data/schema-lib.js';
const B = import.meta.env.BASE_URL;
const title = 'Рецепти з низьким ГІ для стабільного цукру в крові';
const description = 'Безкоштовні рецепти з низьким глікемічним індексом для жінок 40+: випічка без цукру, низьковуглеводні страви й десерти — з оцінкою ГІ для кожного.';
// OPS-301: an 86-recipe index that told crawlers nothing about being a
// collection. Every published recipe is listed, in data order.
const jsonld = hubJsonLd({
  lang: 'ua',
  name: title,
  description,
  url: `${SITE}/ua/recipes/`,
  crumb: "Рецепти",
  items: PUBLISHED.map((r) => ({
    name: r.title['ua'],
    url: `${SITE}/ua/recipes/${r.slug}/`,
  })),
});
---
<BaseLayout
  lang="ua" jsonld={jsonld}
  title={title}
  description={description}
  canonical="/ua/recipes/" alternates={{ en: "/recipes/", ua: "/ua/recipes/" }}
  showList={true}
  enHref={`${B}recipes/`}
  uaHref={`${B}ua/recipes/`}>
  <RecipeHubBody lang="ua" />
</BaseLayout>

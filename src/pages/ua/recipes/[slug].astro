---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RecipeDetailBody from '../../../components/RecipeDetailBody.astro';
import { PUBLISHED } from '../../../data/recipes.js';
import { buildJsonLd, imagesOf, metaDesc, seoTitle } from '../../../data/recipes-lib.js';

export function getStaticPaths() {
  return PUBLISHED.map((R) => ({ params: { slug: R.slug }, props: { R } }));
}

const { R } = Astro.props;
const B = import.meta.env.BASE_URL;
const title = seoTitle(R, 'ua');
const description = metaDesc(R, 'ua');
const ogImage = `/recipes/images/${imagesOf(R)[0]}`;
const jsonld = buildJsonLd(R, 'ua');
---
<BaseLayout
  lang="ua"
  title={title}
  description={description}
  canonical={`/ua/recipes/${R.slug}/`} alternates={{ en: `/recipes/${R.slug}/`, ua: `/ua/recipes/${R.slug}/` }}
  ogImage={ogImage}
  ogType="article"
  jsonld={jsonld}
  showList={true}
  enHref={`${B}recipes/${R.slug}/`}
  uaHref={`${B}ua/recipes/${R.slug}/`}>
  <RecipeDetailBody R={R} lang="ua" />
</BaseLayout>

---
// Resources hub — the editorial system (OPS-276).
//
// Was: seven cards in a three-across grid, each topped by a full-width band of
// its own pale tint. On the pink ground those bands read as section headers; on
// the warm paper they read as seven competing backgrounds, and the tint was
// doing the work a hairline should. The list is also the same set of tools the
// homepage already renders as a numbered index, so the two pages disagreed
// about what a tool looks like.
//
// Now: the homepage's numbered editorial list. Hairlines separate, the number
// carries the eye, and each tool's colour survives as a small accent — a rule in
// the gutter and the subject label — instead of a full band. Colours come from
// `band`/`head` in RESOURCES.cards; every `head` clears 4.5:1 on the paper.
import { RESOURCES, HOME } from '../data/site.js';
const { lang = 'en' } = Astro.props;
const t = RESOURCES[lang];
const cards = RESOURCES.cards;
// Guides render only where they have copy for this language — the meal-plan
// guide is Ukrainian only, so the EN page shows no guides section at all.
const guides = (RESOURCES.guides || []).filter((g) => g[lang]);
// The no-strings promise is the same sentence the homepage makes over this
// exact list, so it is read from there rather than restated.
const free = HOME[lang].toolsFree;
---
<section class="res-head">
  <div class="wrap">
    {/* Label + hairline — the masthead device the homepage, blog and recipe hubs share. */}
    <p class="est"><span class="est-label">{t.kicker}</span><span class="est-rule"></span></p>
    <div class="head">
      <h1>{t.h1}</h1>
      <p class="lede">{t.lead}</p>
    </div>
    {/* Not decoration: "no sign-up, no paywall" is the reason people go on to
        use the tools, so it sits above the list at full strength. */}
    <p class="res-free">{free}</p>
  </div>
</section>

<section class="res-wrap">
  <div class="wrap">
    <div class="res-sec-head">
      <span class="fk">{t.listLabel}</span>
      <span class="fk-n">{String(cards.length).padStart(2, '0')}</span>
    </div>
    <ol class="res-list">
      {cards.map((card, i) => {
        const c = card[lang];
        const raw = lang === 'ua' ? card.hrefUa : card.href;
        // root-relative links (carried-over tool pages) get the deploy base prefix
        const href = raw.startsWith('/') ? import.meta.env.BASE_URL.replace(/\/$/, '') + raw : raw;
        // Optional second destination for a card whose tool has a written
        // companion (OPS-290/OPS-303 follow-up: the trials tracker and its
        // guide). Rendered OUTSIDE the card's own <a> — a link cannot be nested
        // in a link — so the card stays one big target and the guide is its own.
        const guideRaw = lang === 'ua' ? card.guideHrefUa : card.guideHref;
        const guideHref = guideRaw
          ? (guideRaw.startsWith('/') ? import.meta.env.BASE_URL.replace(/\/$/, '') + guideRaw : guideRaw)
          : null;
        return (
          <li class="res-item" style={`--tool: ${card.head}`}>
            <a class="res-tool" href={href}>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="body">
                <span class="meta">
                  <span class="subject">{c.band}</span>
                  <span class="kind">{c.kicker}</span>
                </span>
                <h2>{c.title}</h2>
                <p>{c.desc}</p>
                <span class="go">{c.cta} <span class="ar">&#8594;</span></span>
              </span>
            </a>
            {guideHref && c.guide && (
              <a class="res-guide" href={guideHref}>{c.guide} <span class="ar">&#8594;</span></a>
            )}
          </li>
        );
      })}
    </ol>
  </div>
</section>

{/* Guides sit BELOW the tools and outside their list on purpose: the badge over
    that list promises «Без реєстрації · Без оплати», and these ask for an email
    address. Same row styling so the page reads as one thing, but its own label
    and an explicit note, so nobody clicks expecting no form. */}
{guides.length > 0 && (
  <section class="res-wrap res-guides">
    <div class="wrap">
      <div class="res-sec-head">
        <span class="fk">{t.guidesLabel}</span>
        <span class="fk-n">{String(guides.length).padStart(2, '0')}</span>
      </div>
      <p class="res-guides-note">{t.guidesNote}</p>
      <ol class="res-list">
        {guides.map((guide, i) => {
          const c = guide[lang];
          const raw = lang === 'ua' ? guide.hrefUa : guide.href;
          const href = raw.startsWith('/') ? import.meta.env.BASE_URL.replace(/\/$/, '') + raw : raw;
          return (
            <li class="res-item" style={`--tool: ${guide.head}`}>
              <a class="res-tool" href={href}>
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                <span class="body">
                  <span class="meta">
                    <span class="subject">{c.band}</span>
                    <span class="kind">{c.kicker}</span>
                  </span>
                  <h2>{c.title}</h2>
                  <p>{c.desc}</p>
                  <span class="go">{c.cta} <span class="ar">&#8594;</span></span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>
)}

<style>
  /* The tools section already pads the page bottom, so the guides section only
     needs air above it — not another 72px underneath the last row. */
  .res-guides { padding-top: 8px; }
  .res-guides-note {
    max-width: 62ch; margin: 14px 0 0;
    font-size: var(--fs-small); line-height: 1.6; color: var(--muted);
  }
</style>

---
// One template for every blog article. Renders the typed block list from
// blog.js (p / h / quote / img / graph / table / refs / links / bio) plus
// FAQ, CTA and disclaimer — the same anatomy as the live standalone pages.
// The coming-soon post has no blocks: it shows the note + its short legacy body.
import { UI, AUTHOR_BIO, articleToc, renderInline, relatedPosts } from '../data/blog-lib.js';
import { POSTS } from '../data/blog.js';
import DIMS from '../data/image-dims.json';
import '../styles/blog.css';

const { post, lang = 'en' } = Astro.props;
const a = post[lang];
const t = UI[lang];
const B = import.meta.env.BASE_URL;
const L = lang === 'ua' ? `${B}ua/` : B;
const altHref = `${lang === 'ua' ? B : `${B}ua/`}blog/${post.slug}/`;
// Images still ship at site-absolute /images/… paths in the data.
const img = (src) => B.replace(/\/$/, '') + src;
// Intrinsic dimensions (src/data/image-dims.json) let the browser reserve the
// box before the image loads, so the hero doesn't shift the text (CLS). A
// missing entry just omits the attributes, so new posts render fine before the
// manifest is regenerated (see scripts/generate-image-dims.sh).
const dim = (src) => DIMS[src] || {};
const related = relatedPosts(post, POSTS);
const isTool = post.filedUnder === 'tools';
// Every article closes with the same author signature (OPS-336) — it used to be
// an optional per-post `bio` block and only 12 of 48 posts had one. A post that
// still carries its own bio block keeps it and skips the shared one, so the
// signature never appears twice.
const bio = (a.blocks || []).some((b) => b.t === 'bio') ? null : AUTHOR_BIO[lang];
// Section anchors + the contents list for the right rail (OPS-365). `toc.ids`
// is keyed by block index, so the h2 below and the link above carry the same
// anchor. Short posts get ids but no list — see TOC_MIN in blog-lib.
const toc = articleToc(a, t);
---
<article class="post">
  {/* Article header: kicker, serif headline, then a hairline rule with the
      credit line and the other-language link riding on it. The rule is what
      separates the display block from the reading column. */}
  <header class="post-head">
    <p class="cat">{a.cat}</p>
    <h1>{a.title}</h1>
    <div class="post-meta">
      <p class="byline">{t.byline} · {a.meta}</p>
      <p class="alt"><a href={altHref}>{t.readAlt}</a></p>
    </div>
  </header>
  {post.comingSoon && (
    <div class="soon-note">
      <span class="badge">{t.comingSoonBadge}</span>
      <span>{t.comingSoonNote}</span>
    </div>
  )}
  {/* alt: `imageAlt` describes the photograph; without one we fall back to the
      headline, which is already the <h1> directly above — so a screen reader
      hears the same sentence twice and learns nothing about the image. */}
  <figure><img src={img(post.image)} alt={a.imageAlt || a.title} fetchpriority="high" width={dim(post.image).w} height={dim(post.image).h} /></figure>
  <p class="lead">{a.lead}</p>
  {/* Contents. In the flow here on anything narrower than a desktop — a
      collapsible block under the standfirst — and lifted into the empty right
      margin as a sticky rail from 1320px up, where there is room for it beside
      the measure. One list, two placements: see .toc-rail in blog.css. */}
  {toc.show && (
    <div class="toc-rail">
      <details class="toc" open>
        <summary>{t.tocTitle}</summary>
        <nav aria-label={t.tocTitle}>
          <ol>
            {toc.items.map((h) => (
              <li><a href={`#${h.id}`}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      </details>
      {/* Open is the right default in the rail and the wrong one in the flow:
          fourteen sections between the standfirst and the first paragraph is a
          wall on a phone. Inline and directly after the element so it runs
          before paint rather than collapsing in front of the reader — and only
          ever removes `open`, so with no JS the list is simply expanded. */}
      <script is:inline>
        if (window.matchMedia('(max-width: 1319.98px)').matches)
          document.currentScript.previousElementSibling.removeAttribute('open');
      </script>
    </div>
  )}
  <div class="prose">
    {(a.blocks || []).map((b, i) => {
      if (b.t === 'p') return <p set:html={renderInline(b.text, B)} />;
      if (b.t === 'h') return <h2 id={toc.ids.get(i)}>{b.text}</h2>;
      if (b.t === 'quote') return <blockquote>{b.text}</blockquote>;
      if (b.t === 'img' || b.t === 'graph')
        return <figure><img src={img(b.src)} alt={b.alt} loading="lazy" width={dim(b.src).w} height={dim(b.src).h} />{b.cap && <figcaption>{b.cap}</figcaption>}</figure>;
      if (b.t === 'table')
        return <div class={b.wide ? 'tbl tbl-wide' : 'tbl'}><table>
          <thead><tr>{b.head.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>{b.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
        </table></div>;
      if (b.t === 'embed')
        return <figure class="embed">
          <iframe class="lf-embed" src={B.replace(/\/$/, '') + b.src} title={b.title || a.title} loading="lazy" scrolling="no" style={`width:100%;border:0;display:block;min-height:${b.minHeight || 620}px;`}></iframe>
          {b.cap && <figcaption>{b.cap}</figcaption>}
        </figure>;
      if (b.t === 'refs')
        return <div class="refs">
          {/* UI.refsNote already existed in both languages but was never
              rendered; the source list needs a head now that it is a ruled
              block rather than a stack of cards. */}
          <p class="refs-title">{t.refsNote}</p>
          {b.items.map((r) => (
          <div class="ref">
            <strong>{r.claim}</strong>
            <p>{r.detail}</p>
            {r.url && <a href={r.url} target="_blank" rel="noopener noreferrer">{r.cite} ↗</a>}
            {!r.url && <span class="ref-cite">{r.cite}</span>}
          </div>
        ))}
        </div>;
      if (b.t === 'links')
        return <div class="cards">{b.items.map((l) => (
          /* Most "related reading" cards point at other posts on this site, so
             branch on the href the same way renderInline() does: internal links
             stay in the tab and drop the ↗, only genuinely external ones keep
             target/rel and the glyph. */
          l.url.startsWith('/')
            ? <a class="card" href={B.replace(/\/$/, '') + l.url}>
                <strong>{l.name}</strong>
                <span>{l.desc}</span>
              </a>
            : <a class="card" href={l.url} target="_blank" rel="noopener noreferrer">
                <strong>{l.name} ↗</strong>
                <span>{l.desc}</span>
              </a>
        ))}</div>;
      if (b.t === 'bio')
        return <div class="bio">
          <img src={img(b.img)} alt={b.alt} loading="lazy" />
          <div><strong>{b.name}</strong><p>{b.text}</p></div>
        </div>;
      return null;
    })}
    {!a.blocks && (a.body || []).map((p) => <p>{p}</p>)}
    {bio && (
      <div class="bio">
        <img src={img(bio.img)} alt={bio.alt} loading="lazy" />
        <div><strong>{bio.name}</strong><p>{bio.text}</p></div>
      </div>
    )}
  </div>
  {a.faq && a.faq.length > 0 && (
    <section class="faq">
      <h2 id="faq">{t.faqTitle}</h2>
      {a.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="ans"><p>{f.a}</p></div>
        </details>
      ))}
    </section>
  )}
  <aside class="cta">
    <h2>{t.ctaTitle}</h2>
    <p>{t.ctaBody}</p>
    <a href={`${L}contact/`}>{t.ctaBtn}</a>
  </aside>
  <p class="disclaimer">{t.disclaimer}</p>
</article>
{related.length > 0 && (
  <aside class="related" aria-label={t.relatedTitle}>
    <h2>{t.relatedTitle}</h2>
    <div class="rel-grid">
      {related.map((p) => (
        <a class="rel-card" href={`${L}blog/${p.slug}/`}>
          <div class="thumb" style={`background-image:url('${img(p.image)}')`}></div>
          <div class="body">
            <p class="cat">{p[lang].cat}</p>
            <h3>{p[lang].title}</h3>
            <p class="meta">{p[lang].meta}</p>
          </div>
        </a>
      ))}
    </div>
  </aside>
)}
{/* A tool page's way out is the tools list, not the Journal it no longer
    appears in (OPS-290) — the reader arrived from Tools & guides. */}
<div class="post-foot"><a href={isTool ? `${L}resources/` : `${L}blog/`}>{isTool ? t.backToTools : t.backToBlog}</a></div>

{/* Contents: mark the section the reader is in (OPS-365). Progressive
    enhancement — without it the rail is still a working list of links, so
    nothing here runs unless the list is actually on the page. The reading
    progress bar in BaseLayout measures on the same scroll/rAF pattern. */}
<script is:inline>
  (function () {
    var links = document.querySelectorAll('.toc a[href^="#"]');
    if (!links.length) return;

    var targets = [];
    for (var i = 0; i < links.length; i++) {
      // Cyrillic anchors come back from .hash percent-encoded; getElementById
      // wants the character, not the escape.
      var el = document.getElementById(decodeURIComponent(links[i].hash.slice(1)));
      if (el) targets.push({ el: el, link: links[i] });
    }
    if (!targets.length) return;

    var current = null;
    var ticking = false;

    // The heading whose top has most recently passed under the masthead is the
    // section being read — with sections 56px apart and a tall screen, several
    // are in view at once, so "last one above the line" is the answer and
    // "whichever is visible" is not. Above the first heading nothing is
    // current: highlighting section one while you are still on the standfirst
    // would be a lie about where you are.
    function paint() {
      ticking = false;
      var found = null;
      for (var i = 0; i < targets.length; i++) {
        if (targets[i].el.getBoundingClientRect().top <= 110) found = targets[i];
        else break;
      }
      if (found === current) return;
      if (current) current.link.removeAttribute('aria-current');
      current = found;
      if (current) current.link.setAttribute('aria-current', 'true');
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(paint);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    paint();
  })();
</script>

{/* Auto-resize any embedded interactive tool (embed block) to its content height. */}
<script is:inline>
  window.addEventListener('message', function (e) {
    if (!e.data || e.data.type !== 'lf-embed-height' || typeof e.data.height !== 'number') return;
    document.querySelectorAll('iframe.lf-embed').forEach(function (f) {
      if (f.contentWindow === e.source) f.style.height = e.data.height + 'px';
    });
  });
</script>

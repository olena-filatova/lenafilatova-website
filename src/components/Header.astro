---
// Shared site header. Built ONCE — every page reuses it.
// Props:
//   lang     — 'en' | 'ua'
//   showList — when true, render the recipe shopping-list button (#listBtn)
//   enHref / uaHref — where the EN/UA toggle points (defaults to About).
//     Recipe pages pass their own counterpart so the toggle keeps the recipe.
import { NAV } from '../data/site.js';
import { SEARCH_UI } from '../data/search-lib.js';
import SearchPanel from './SearchPanel.astro';
const { lang = 'en', showList = false, enHref, uaHref } = Astro.props;
const t = NAV[lang];
const s = SEARCH_UI[lang];
const B = import.meta.env.BASE_URL;                 // '/…preview/' now, '/' at root
const L = lang === 'ua' ? `${B}ua/` : B;            // language-scoped base
// Default the toggle to the SAME page in the other language, derived from the
// current path — not to /about/. The old default meant any page that didn't
// pass enHref/uaHref (the homepage, about, contact, shop, legal) threw the
// visitor onto About instead of translating where they were.
const path = Astro.url.pathname;
const rel = path.startsWith(B) ? path.slice(B.length) : path.replace(/^\//, '');
const relEn = rel === 'ua' || rel === 'ua/' ? '' : rel.startsWith('ua/') ? rel.slice(3) : rel;
const enTo = enHref || `${B}${relEn}`;
const uaTo = uaHref || `${B}ua/${relEn}`;

// Which nav item is the current page. Prefix match rather than equality, so a
// post (/blog/some-post/) or a recipe (/recipes/yerba-mate/) still lights up its
// section. Both sides are normalised to a trailing slash. The UA links already
// carry the /ua/ segment via L, so /ua/blog/… can only ever match the UA item —
// and the homepage ('/') matches nothing, which is what we want.
const slash = (s) => (s.endsWith('/') ? s : `${s}/`);
const here = slash(Astro.url.pathname);
const isHere = (href) => here.startsWith(slash(href));

const NAV_ITEMS = [
  { href: `${L}blog/`, label: t.blog },
  { href: `${L}resources/`, label: t.resources },
  { href: `${L}recipes/`, label: t.recipes },
  { href: `${L}about/`, label: t.about },
  { href: `${L}contact/`, label: t.contact },
];
---
{/* `has-list` tells the stylesheet the bar is carrying the extra
    shopping-list button, which is what makes it too crowded for the wordmark
    on a small phone. A class rather than `:has(.list-btn)` because the
    component already knows, and this can't depend on selector support. */}
<header class:list={['site-header', { 'has-list': showList }]}>
  <div class="wrap inner">
    {/* The wordmark is wrapped so the narrowest phones can drop it and keep
        the disc — the bar now carries a search icon as well. */}
    <a class="brand" href={L}><span class="mark">lf</span><span class="brand-name">Lena Filatova</span></a>
    <nav class="site-nav">
      {NAV_ITEMS.map((n) => (
        <a href={n.href} class={isHere(n.href) ? 'active' : undefined} aria-current={isHere(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      {/* The magnifying glass is the whole search affordance in the chrome —
          it opens SearchPanel below this bar. It comes before the language
          toggle so the two icon-only controls (search, burger) don't end up
          separated by it on a phone. */}
      <button class="search-btn" id="searchOpen" type="button" aria-label={s.open} title={s.open}
              aria-expanded="false" aria-controls="searchPanel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
      </button>
      <span class="lang">
        <a href={enTo} class={lang === 'en' ? 'on' : ''}>EN</a>
        <a href={uaTo} class={lang === 'ua' ? 'on' : ''}>UA</a>
      </span>
      {showList ? (
        <button class="list-btn" id="listBtn" aria-label="Shopping list" title="Shopping list">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 13l2 2 4-4"/></svg>
          <span class="list-badge" id="listBadge">0</span>
        </button>
      ) : (
        <a class="btn subscribe-btn" href="#newsletter">{t.subscribe}</a>
      )}
      <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false" aria-controls="mobileNav">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobileNav" hidden>
    {NAV_ITEMS.map((n) => (
      <a href={n.href} class={isHere(n.href) ? 'active' : undefined} aria-current={isHere(n.href) ? 'page' : undefined}>{n.label}</a>
    ))}
    {/* Also in the burger, spelled out: the icon is discoverable for people
        who look for one, this is for people who read the menu. */}
    <a href={`${L}search/`} class={isHere(`${L}search/`) ? 'active' : undefined} aria-current={isHere(`${L}search/`) ? 'page' : undefined}>{s.label}</a>
    <a class="btn" href="#newsletter">{t.subscribe}</a>
  </nav>
  <SearchPanel lang={lang} />
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('navToggle');
    var nav = document.getElementById('mobileNav');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () {
      var open = nav.hidden;
      nav.hidden = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.classList.toggle('open', open);
    });
  })();
</script>

---
// Shared site header. Built ONCE — every page reuses it.
// Props:
//   lang     — 'en' | 'ua'
//   showList — when true, render the recipe shopping-list button (#listBtn)
//   enHref / uaHref — where the EN/UA toggle points (defaults to About).
//     Recipe pages pass their own counterpart so the toggle keeps the recipe.
import { NAV } from '../data/site.js';
const { lang = 'en', showList = false, enHref, uaHref } = Astro.props;
const t = NAV[lang];
const B = import.meta.env.BASE_URL;                 // '/…preview/' now, '/' at root
const L = lang === 'ua' ? `${B}ua/` : B;            // language-scoped base
const enTo = enHref || `${B}about/`;
const uaTo = uaHref || `${B}ua/about/`;

// Which nav item is the current page. Prefix match rather than equality, so a
// post (/blog/some-post/) or a recipe (/recipes/yerba-mate/) still lights up its
// section. Both sides are normalised to a trailing slash. The UA links already
// carry the /ua/ segment via L, so /ua/blog/… can only ever match the UA item —
// and the homepage ('/') matches nothing, which is what we want.
const slash = (s) => (s.endsWith('/') ? s : `${s}/`);
const here = slash(Astro.url.pathname);
const isHere = (href) => here.startsWith(slash(href));

const NAV_ITEMS = [
  { href: `${L}blog/`, label: t.blog },
  { href: `${L}resources/`, label: t.resources },
  { href: `${L}recipes/`, label: t.recipes },
  { href: `${L}about/`, label: t.about },
  { href: `${L}contact/`, label: t.contact },
];
---
<header class="site-header">
  <div class="wrap inner">
    <a class="brand" href={L}><span class="mark">lf</span>Lena Filatova</a>
    <nav class="site-nav">
      {NAV_ITEMS.map((n) => (
        <a href={n.href} class={isHere(n.href) ? 'active' : undefined} aria-current={isHere(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <span class="lang">
        <a href={enTo} class={lang === 'en' ? 'on' : ''}>EN</a>
        <a href={uaTo} class={lang === 'ua' ? 'on' : ''}>UA</a>
      </span>
      {showList ? (
        <button class="list-btn" id="listBtn" aria-label="Shopping list" title="Shopping list">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 13l2 2 4-4"/></svg>
          <span class="list-badge" id="listBadge">0</span>
        </button>
      ) : (
        <a class="btn subscribe-btn" href={`${L}contact/`}>{t.subscribe}</a>
      )}
      <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false" aria-controls="mobileNav">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobileNav" hidden>
    {NAV_ITEMS.map((n) => (
      <a href={n.href} class={isHere(n.href) ? 'active' : undefined} aria-current={isHere(n.href) ? 'page' : undefined}>{n.label}</a>
    ))}
    <a class="btn" href={`${L}contact/`}>{t.subscribe}</a>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('navToggle');
    var nav = document.getElementById('mobileNav');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () {
      var open = nav.hidden;
      nav.hidden = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.classList.toggle('open', open);
    });
  })();
</script>

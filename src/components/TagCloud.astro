---
// The topic cloud (OPS-367). Every tag, sized by how many articles carry it.
//
// It is a cloud rather than another row of filter chips because the size IS the
// information: it tells a reader at a glance that there are twelve articles on
// blood sugar and one on hair loss, which the Journal's flat category chips
// cannot. Grouped, because 32 unordered links is a wall — the groups are the
// same ones a reader would sort them into.
import { POSTS } from '../data/blog.js';
import { TAG_GROUPS } from '../data/tags.js';
import { resolveTags, withWeights, tagPath, UI } from '../data/tags-lib.js';
// The cloud's own styles live in blog.css, and this component used to rely on
// whichever page embedded it having imported that file. /blog/ does (through
// BlogHubBody); /blog/topics/ does not — so the Topics page shipped the cloud
// as a bare bulleted list with disc markers, live, at every width. Importing
// it here makes the component carry its own styles wherever it is used, which
// is the only version of this that cannot break again. Astro de-duplicates the
// import, so pages that already pull blog.css are unaffected.
import '../styles/blog.css';

// `tabs` (OPS-604): one group open at a time, picked from a row of group names.
// Eight groups at once is 40-odd links between the reader and the articles;
// Lena asked for fewer on screen at all times. The Topics page passes
// tabs={false} — it IS the full index, so it keeps every group open.
//
// `uid` prefixes the tab/panel ids and `place` adds a `cloud--<place>` class.
// The Journal index renders the cloud twice — under the title for wide
// screens, above the grid for narrow ones — and shows one of them (see
// BlogHubBody and blog.css), so the ids have to differ between the two.
const { lang = 'en', heading = true, exclude = null, tabs = true, uid = 'cloud', place = null } = Astro.props;
const t = UI[lang];
const B = import.meta.env.BASE_URL;
const all = withWeights(resolveTags(POSTS));
const tags = all.filter((x) => x.key !== exclude);
const groups = TAG_GROUPS.map((g) => ({ ...g, items: tags.filter((x) => x.group === g.key) })).filter(
  (g) => g.items.length
);
// Open by default: on a tag page, the group the reader is already in (its
// siblings are the likeliest next click); everywhere else, the first group.
const home = exclude && all.find((x) => x.key === exclude)?.group;
const open = (groups.find((g) => g.key === home) || groups[0])?.key;
---
<section class={`cloud${place ? ` cloud--${place}` : ''}`} data-tabs={tabs ? '' : undefined}>
  <div class="wrap">
    {tabs ? (
      <div class="hub-bar">
        <span class="fk">{t.cloudTitle}</span>
        <div class="blog-filters cloud-tabs" role="tablist" aria-label={t.cloudTitle}>
          {groups.map((g) => (
            <button
              class={`chip${g.key === open ? ' on' : ''}`}
              type="button"
              role="tab"
              id={`${uid}-tab-${g.key}`}
              aria-controls={`${uid}-panel-${g.key}`}
              aria-selected={g.key === open ? 'true' : 'false'}
              tabindex={g.key === open ? 0 : -1}>
              {g[lang]}
            </button>
          ))}
        </div>
      </div>
    ) : (
      heading && (
        <div class="hub-head">
          <span class="fk">{t.cloudTitle}</span>
        </div>
      )
    )}
    {heading && !tabs && <p class="cloud-lead">{t.cloudLead}</p>}
    {/* Without JS the tabs cannot switch, so every group shows instead. */}
    {tabs && (
      <noscript>
        <style>{`.cloud[data-tabs] .cloud-group[hidden]{display:block}.cloud[data-tabs] .cloud-tabs{display:none}.cloud[data-tabs] .cloud-group h3{display:block}`}</style>
      </noscript>
    )}
    <div class="cloud-groups">
      {groups.map((g) => (
        <div
          class="cloud-group"
          id={tabs ? `${uid}-panel-${g.key}` : undefined}
          role={tabs ? 'tabpanel' : undefined}
          aria-labelledby={tabs ? `${uid}-tab-${g.key}` : undefined}
          hidden={tabs && g.key !== open}>
          <h3>{g[lang]}</h3>
          <ul>
            {g.items.map((x) => (
              <li>
                <a href={`${B.replace(/\/$/, '')}${tagPath(lang, x.key)}`} data-w={x.weight}>
                  {x[lang]}
                  {/* The count is the cloud's whole claim, so it is text a
                      screen reader reaches rather than size alone. */}
                  <span class="n">{x.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
{tabs && (
  <script is:inline>
    (function () {
      document.querySelectorAll('.cloud[data-tabs]').forEach(function (cloud) {
        var tabs = [].slice.call(cloud.querySelectorAll('[role="tab"]'));
        function pick(tab, focus) {
          tabs.forEach(function (x) {
            var on = x === tab;
            x.classList.toggle('on', on);
            x.setAttribute('aria-selected', on ? 'true' : 'false');
            x.tabIndex = on ? 0 : -1;
            document.getElementById(x.getAttribute('aria-controls')).hidden = !on;
          });
          if (focus) tab.focus();
          reveal(tab);
        }
        // On narrow screens the tabs are one swipeable line (blog.css), so the
        // selected one can sit off the edge — on a tag page the open group is
        // whichever the tag belongs to. Scroll the strip, never the page.
        function reveal(tab) {
          var strip = tab.parentNode;
          if (strip.scrollWidth <= strip.clientWidth) return;
          var left = tab.offsetLeft - strip.offsetLeft;
          if (left < strip.scrollLeft || left + tab.offsetWidth > strip.scrollLeft + strip.clientWidth) {
            strip.scrollLeft = Math.max(0, left - 24);
          }
        }
        var current = cloud.querySelector('[role="tab"][aria-selected="true"]');
        if (current) reveal(current);
        tabs.forEach(function (tab, i) {
          tab.addEventListener('click', function () { pick(tab); });
          tab.addEventListener('keydown', function (e) {
            var to = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : null;
            if (to === null) return;
            e.preventDefault();
            pick(tabs[(to + tabs.length) % tabs.length], true);
          });
        });
      });
    })();
  </script>
)}

---
import { HOME, RESOURCES } from '../data/site.js';
import { POSTS } from '../data/blog.js';
import Newsletter from './Newsletter.astro';
const { lang = 'en' } = Astro.props;
const t = HOME[lang];
const B = import.meta.env.BASE_URL;
const L = lang === 'ua' ? `${B}ua/` : B;
const resourcesHref = `${L}resources/`;
const blogHref = `${L}blog/`;
const recipesAllHref = `${L}recipes/`;
const img = (src) => B.replace(/\/$/, '') + src;

// Blog: featured first, then newest-by-date. Desktop shows the lead large +
// two more recent; mobile shows only the lead (the two extras are hidden).
const recentPosts = [...POSTS].filter((p) => !p.comingSoon).sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0) || b.date.localeCompare(a.date));
const latestPost = recentPosts[0];
const latestPostT = latestPost[lang];
const morePosts = recentPosts.slice(1, 3);

const featuredRecipe = HOME.recipe;

// Featured resources: food calculator, carb/GI table, blood sugar investigator.
// One shows on mobile (res-extra hidden); all three show on wide screens.
const featuredResources = [0, 6, 5].map((i) => RESOURCES.cards[i]);
---
<!-- HERO -->
<!-- Bands alternate tint → paper → tint … down the page (OPS-156). The band
     classes are homepage-only on purpose: `.section` is shared with the blog,
     recipe and resource hubs, which set their own rhythm. -->
<section class="hero home home-band home-band--hero">
  <div class="wrap grid">
    <div>
      <p class="kicker">{t.heroKicker}</p>
      <h1>{t.heroH1}</h1>
      <p class="lead">{t.heroLead}</p>
      <div class="hero-cta">
        <a class="btn" href="#newsletter">{t.heroCta2}</a>
      </div>
    </div>
    <div class="photo">
      <img
        src={img('/images/lena-filatova-womens-health-coach-over-40.jpg')}
        alt={lang === 'ua'
          ? 'Lena Filatova — коуч з жіночого здоров’я та харчування для жінок 40+'
          : "Lena Filatova, women's health and nutrition coach for women over 40"}
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<!-- TRUST STRIP — real credentials, a quick "why trust her" band under the hero -->
<section class="stats" aria-label={t.trustLabel}>
  <div class="wrap grid">
    {t.trust.map((s) => (
      <div class="stat"><div class="n">{s.n}</div><div class="l">{s.l}</div></div>
    ))}
  </div>
</section>

<!-- FROM THE BLOG: latest article (freshest content, featured first) -->
<section class="section home-band home-band--paper reveal">
  <div class="wrap">
    <div class="section-head">
      <div><h2>{t.blogTitle}</h2><p class="section-sub">{t.blogSub}</p></div>
      <a class="see-all" href={blogHref}>{t.blogAll}</a>
    </div>
    <a class="feature-card" href={`${L}blog/${latestPost.slug}/`}>
      <div class="feature-photo"><img src={img(latestPost.image)} alt={latestPostT.title} loading="lazy" /></div>
      <div class="feature-body">
        <span class="mini-cat">{latestPostT.cat}</span>
        <h3>{latestPostT.title}</h3>
        <p class="feature-desc">{latestPostT.excerpt}</p>
        <p class="feature-meta">{latestPostT.meta}</p>
        <span class="btn">{t.blogCta}</span>
      </div>
    </a>
    <div class="blog-more reveal-group">
      {morePosts.map((p) => {
        const pt = p[lang];
        return (
          <a class="post-mini" href={`${L}blog/${p.slug}/`}>
            <div class="post-mini-photo"><img src={img(p.image)} alt={pt.title} loading="lazy" /></div>
            <div class="post-mini-body">
              <span class="mini-cat">{pt.cat}</span>
              <h3>{pt.title}</h3>
              <p class="post-mini-meta">{pt.meta}</p>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<!-- FROM MY KITCHEN: one recipe (image mirrored vs the blog card on wide screens) -->
<section class="section home-band reveal">
  <div class="wrap">
    <div class="section-head">
      <div><h2>{t.recipesTitle}</h2><p class="section-sub">{t.recipesSub}</p></div>
      <a class="see-all" href={recipesAllHref}>{t.recipesAll}</a>
    </div>
    <a class="feature-card reverse" href={`${L}recipes/${featuredRecipe.slug}/`}>
      <div class="feature-photo recipe-photo"><img src={img(featuredRecipe.img)} alt={featuredRecipe.title[lang]} loading="lazy" /></div>
      <div class="feature-body">
        <span class="mini-cat">{featuredRecipe.cat[lang]}</span>
        <h3>{featuredRecipe.title[lang]}</h3>
        <p class="feature-desc">{featuredRecipe.desc[lang]}</p>
        <p class="feature-meta">GI {featuredRecipe.gi} · {featuredRecipe.carbs}{lang === 'ua' ? ' ' : 'g '}{t.carbs}</p>
        <span class="btn">{t.recipeCta}</span>
      </div>
    </a>
  </div>
</section>

<!-- FREE TOOLS & GUIDES: one card on mobile, three on wide screens -->
<section class="section home-band home-band--paper reveal">
  <div class="wrap">
    <div class="section-head">
      <div><h2>{t.resourcesTitle}</h2><p class="section-sub">{t.resourcesSub}</p></div>
      <a class="see-all" href={resourcesHref}>{t.resourcesAll}</a>
    </div>
    <div class="res-grid reveal-group">
      {featuredResources.map((card, i) => {
        const c = card[lang];
        const raw = lang === 'ua' ? card.hrefUa : card.href;
        const href = raw.startsWith('/') ? B.replace(/\/$/, '') + raw : raw;
        return (
          <a class={i === 0 ? 'rcard' : 'rcard res-extra'} href={href}>
            <div class="rband" style={`background:${card.band}`}>
              <span style={`color:${card.head}`}>{c.band}</span>
            </div>
            <div class="rbody">
              <p class="rkicker">{c.kicker}</p>
              <h3>{c.title}</h3>
              <p class="rdesc">{c.desc}</p>
              <span class="rcta">{c.cta}</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<!-- WHAT I HELP WITH — the topic overview, now near the bottom as a lead-out
     to the newsletter (fresh content catches attention up top instead) -->
<section class="section home-band reveal">
  <div class="wrap">
    <h2>{t.helpTitle}</h2>
    <p class="section-sub">{t.helpSub}</p>
    <div class="help-grid reveal-group">
      {t.help.map((c, i) => (
        <div class="help-card" style={`--c:${HOME.helpColors[i]};--n:${HOME.helpNums[i]}`}>
          <span class="help-num">{String(i + 1).padStart(2, '0')}</span>
          <div class="help-text">
            <h3>{c.h}</h3>
            <p>{c.p}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- NEWSLETTER — markup, language tagging, anti-spam and submit handling all
     live in the component now; it posts straight to Mailchimp rather than via
     the Apps Script relay. The homepage renders its own so the section keeps
     its place in the page flow, and BaseLayout skips the above-footer band. -->
<Newsletter lang={lang} sectionClass="home-band home-band--paper reveal" />

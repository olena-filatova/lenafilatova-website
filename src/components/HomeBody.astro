---
// Homepage — editorial redesign (Aug 2026).
//
// SCOPE: the look here (warm paper, serif display, hairline rules, numbered
// indices, square buttons) is now the SITE-WIDE system. Its tokens were lifted
// out of this file into global.css in OPS-270, so --accent / --ink / --bg /
// --paper2 / --line / --rule below are the shared ones — change them there, not
// here. What stays in this component's scoped <style> is only the layout that
// is genuinely particular to the homepage (hero, trust band, numbered sections,
// voices, waitlist). Page-level restyles land in OPS-273 to OPS-278.
//
// ORDER is deliberate: problem-led hero -> why trust her -> free tools (give
// before asking) -> freshness -> pleasure -> proof it works -> scope -> the ask.
// Tools sit above the blog on purpose: they are the reciprocity step and the
// stickiest content on the site.
import { HOME, RESOURCES } from '../data/site.js';
import { POSTS } from '../data/blog.js';
import { hasHero } from '../data/blog-lib.js';
import DIMS from '../data/image-dims.json';
import Picture from './Picture.astro';
import Newsletter from './Newsletter.astro';

const { lang = 'en' } = Astro.props;
const t = HOME[lang];
const B = import.meta.env.BASE_URL;
const L = lang === 'ua' ? `${B}ua/` : B;
const img = (src) => B.replace(/\/$/, '') + src;
// Drawn widths for the editorial band, so each picture takes the rung it
// needs off the AVIF ladder rather than the largest one every time.
const PORTRAIT_SIZES = '(min-width: 1000px) 360px, calc(100vw - 48px)';
const BAND_SIZES = '(min-width: 1000px) 330px, calc(100vw - 48px)';
const blogHref = `${L}blog/`;
const recipesAllHref = `${L}recipes/`;
const resourcesHref = `${L}resources/`;

// NEWEST, not the editorial pick (OPS-299). These are two different jobs and
// this band does the first one: section 02 sits in the "freshness" slot of the
// page order above, so it has to move when Lena publishes. `featured` is the
// *editorial* pick and belongs to the /blog/ band only — letting it win the
// sort here is what froze this card on a June post while 39 newer ones piled
// up behind it. If you want a hand-picked post on the homepage, add a separate
// field for it; do not reintroduce `featured` into this comparator.
const recentPosts = [...POSTS]
  .filter((p) => !p.comingSoon && p.filedUnder !== 'tools')
  .sort((a, b) => b.date.localeCompare(a.date));
const latestPost = recentPosts[0];
const latestPostT = latestPost[lang];

const featuredRecipe = HOME.recipe;

// Four tools, ordered by usefulness to someone new: what this food does, what
// every food does, why today went wrong, what to buy next.
const tools = [0, 6, 5, 4].map((i) => RESOURCES.cards[i]);
const numerals = ['i', 'ii', 'iii', 'iv'];
const toolHref = (card) => {
  const raw = lang === 'ua' ? card.hrefUa : card.href;
  return raw.startsWith('/') ? B.replace(/\/$/, '') + raw : raw;
};
---

<div class="ed">
  <!-- HERO -->
  <section class="ed-hero">
    <div class="wrap ed-hero-lay">
      <div>
        <p class="ed-est"><span class="ed-label">{t.heroKicker}</span><span class="ed-rule"></span></p>
        <h1>{t.heroH1} <span class="it">{t.heroH1b}</span></h1>
        <p class="ed-lead">{t.heroLead}</p>
        <div class="ed-cta">
          <a class="ed-btn mag" href={toolHref(tools[0])}>{t.heroCta1} <span class="ar">&#8594;</span></a>
          <a class="ed-btn line" href="#newsletter">{t.heroCta2}</a>
        </div>
        <p class="ed-disclaimer">{t.disclaimer}</p>
      </div>
      <div class="ed-portrait">
        <div class="ed-shot">
        <span class="ed-blk"></span>
        <div class="ed-frame">
          <Picture
            src="/images/lena-filatova-womens-health-coach-over-40.jpg"
            sizes={PORTRAIT_SIZES}
            alt={lang === 'ua'
              ? 'Lena Filatova — коуч з жіночого здоров’я та харчування для жінок 40+'
              : "Lena Filatova, women's health and nutrition coach for women over 40"}
            fetchpriority="high"
            decoding="async"
          />
        </div>
        </div>
        <p class="ed-cap">{t.heroNote}</p>
      </div>
    </div>
  </section>

  <!-- TRUST BAND -->
  <section class="ed-band" aria-label={t.trustLabel}>
    <div class="wrap ed-band-grid">
      {t.trust.map((s) => (
        <div class="ed-stat"><div class="n">{s.n}</div><div class="l">{s.l}</div></div>
      ))}
    </div>
  </section>

  <!-- 01 FREE TOOLS -->
  <section class="ed-sec" id="tools">
    <div class="wrap">
      <div class="ed-head">
        <span class="ed-num">01</span>
        <h2 class="ed-name">{t.resourcesTitle}</h2>
        <a class="ed-more" href={resourcesHref}>{t.resourcesAll} &#8594;</a>
      </div>
      <span class="ed-free">{t.toolsFree}</span>
      <div class="ed-tools">
        {tools.map((card, i) => {
          const c = card[lang];
          return (
            <a class="ed-tool" href={toolHref(card)}>
              <span class="idx">{numerals[i]}</span>
              <span class="body">
                <span class="tag">{c.kicker}</span>
                <h3>{c.title}</h3>
                <p>{c.desc}</p>
                {/* The arrow is markup, not data — RESOURCES cta strings used to
                    carry their own "→" and rendered here as a doubled arrow. */}
                <span class="go">{c.cta} &#8594;</span>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 02 BLOG -->
  <section class="ed-sec">
    <div class="wrap">
      <div class="ed-head">
        <span class="ed-num">02</span>
        <h2 class="ed-name">{t.blogTitle}</h2>
        <a class="ed-more" href={blogHref}>{t.blogAll} &#8594;</a>
      </div>
      <a class="ed-feat" href={`${L}blog/${latestPost.slug}/`}>
        <div class="ph">{hasHero(latestPost, DIMS) && <Picture src={latestPost.image} alt={latestPostT.title} sizes={BAND_SIZES} loading="lazy" />}</div>
        <div class="body">
          <span class="cat">{latestPostT.cat}</span>
          <h3>{latestPostT.title}</h3>
          <p>{latestPostT.excerpt}</p>
          <p class="meta">{latestPostT.meta}</p>
          <span class="ed-readmore">{t.blogCta}</span>
        </div>
      </a>
    </div>
  </section>

  <!-- 03 RECIPE -->
  <section class="ed-sec">
    <div class="wrap">
      <div class="ed-head">
        <span class="ed-num">03</span>
        <h2 class="ed-name">{t.recipesTitle}</h2>
        <a class="ed-more" href={recipesAllHref}>{t.recipesAll} &#8594;</a>
      </div>
      <a class="ed-rec" href={`${L}recipes/${featuredRecipe.slug}/`}>
        <div class="ph">
          <span class="gi"><b>{featuredRecipe.gi}</b><span>GI</span></span>
          <Picture src={featuredRecipe.img} alt={featuredRecipe.title[lang]} sizes={BAND_SIZES} loading="lazy" />
        </div>
        <div class="body">
          <span class="ed-label dim">{featuredRecipe.cat[lang]} · {featuredRecipe.carbs}{lang === 'ua' ? ' ' : 'g '}{t.carbs}</span>
          <h3>{featuredRecipe.title[lang]}</h3>
          <p>{featuredRecipe.desc[lang]}</p>
          <span class="ed-readmore">{t.recipeCta}</span>
        </div>
      </a>
      <p class="ed-docline">&#8220;{t.recipeDoc}&#8221;<span>{t.recipeDocWho}</span></p>
    </div>
  </section>

  <!-- 04 VOICES -->
  <section class="ed-voices">
    <div class="wrap">
      <div class="ed-head">
        <span class="ed-num">04</span>
        <span class="ed-name">{t.voicesLabel}</span>
      </div>
      <h2>{t.voicesTitle}</h2>
      <p class="ed-intro">{t.voicesSub}</p>
      <div class="ed-qs">
        {t.voices.map((v) => {
          const parts = v.hl && v.q.includes(v.hl) ? v.q.split(v.hl) : null;
          return (
            <blockquote class="ed-q">
              <p>&#8220;{parts ? (<Fragment>{parts[0]}<span class="hl">{v.hl}</span>{parts.slice(1).join(v.hl)}</Fragment>) : v.q}&#8221;</p>
              <cite>{v.who}</cite>
            </blockquote>
          );
        })}
      </div>
      <div class="ed-clin">
        <span class="k">{t.clinicianLabel}</span>
        <div>
          <p class="cq">&#8220;{t.clinicianQuote}&#8221;</p>
          <p class="cw">{t.clinicianWho}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 WHAT I HELP WITH -->
  <section class="ed-sec">
    <div class="wrap">
      <div class="ed-head">
        <span class="ed-num">05</span>
        <h2 class="ed-name">{t.helpTitle}</h2>
      </div>
      <div class="ed-rows">
        {t.help.map((c, i) => (
          <div class="ed-row">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{c.h}</h3><p>{c.p}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>
</div>

<!-- NEWSLETTER — shared component (markup, language tagging, anti-spam and
     submit handling live there). It now offers the workbook: copy comes from
     HOME[lang].nlTitle / nlSub, so every page's signup carries the same offer. -->
<Newsletter lang={lang} sectionClass="ed-nl" />

<!-- WAITLIST — seeds the future paid products, gives the list a second job. -->
<div class="ed">
  <section class="ed-wait">
    <div class="wrap inner">
      <div>
        <h4>{t.waitlistTitle}</h4>
        <p>{t.waitlistText}</p>
      </div>
      <a href="#newsletter">{t.waitlistCta} &#8594;</a>
    </div>
  </section>
</div>

<style>
  /* Tokens now live in global.css (OPS-270) — this page reads the same
     --accent / --ink / --bg / --line set as the rest of the site. */
  .ed { background: var(--bg); }
  .ed :is(h1, h2, h3, h4) { font-family: var(--font-head); color: var(--ink); font-weight: 400; letter-spacing: -0.01em; margin: 0; }
  .ed p { color: var(--muted); }

  .ed-label { font-family: var(--font-body); font-size: 10.5px; font-weight: 800; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); }
  .ed-label.dim { color: var(--muted); }

  .ed-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    min-height: 54px; width: 100%; padding: 15px 26px; border: 0; border-radius: 0;
    font-family: var(--font-body); font-weight: 700; font-size: 15px;
    background: var(--ink); color: var(--bg); cursor: pointer;
    transition: background 0.2s ease;
  }
  .ed-btn.mag { background: var(--accent); color: #fff; }
  .ed-btn.line { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .ed-btn .ar { font-family: var(--font-head); font-size: 18px; line-height: 1; }

  /* OPS-293: hero type dialled down a step (and its vertical rhythm tightened)
     so the block is more compact and the portrait sits higher. */
  .ed-hero { padding: 20px 0 0; }
  .ed-est { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; }
  .ed-rule { height: 1px; background: var(--rule); flex: 1; }
  .ed-hero h1 { font-size: 30px; line-height: 1.06; letter-spacing: -0.028em; }
  .ed-hero h1 .it { font-style: italic; color: var(--accent); font-weight: 300; }
  .ed-lead { font-family: var(--font-head); font-size: 16.5px; line-height: 1.5; font-weight: 300; margin: 16px 0 0; }
  .ed-cta { display: flex; flex-direction: column; gap: 10px; margin: 20px 0 12px; }
  .ed-disclaimer { display: flex; gap: 8px; align-items: flex-start; font-size: 12.5px; line-height: 1.45; opacity: 0.8; margin: 0 0 18px; }
  .ed-disclaimer::before { content: ''; flex: none; width: 14px; height: 1px; background: var(--accent); margin-top: 9px; }

  .ed-portrait { --peek: 14px; }
  /* The block is anchored to .ed-shot (the photo alone). Anchoring it to
     .ed-portrait put it behind the caption, which is what it was doing. */
  .ed-shot { position: relative; }
  .ed-frame { position: relative; z-index: 2; aspect-ratio: 1 / 1.08; overflow: hidden; background: var(--paper2); border-radius: 50% 50% 0 0 / 38% 38% 0 0; }
  .ed-frame img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; }
  .ed-blk { position: absolute; z-index: 1; left: -10px; right: 34%; bottom: calc(var(--peek) * -1); height: 46%; background: var(--accent); }
  /* the block's overhang drives the caption offset, so they cannot collide */
  .ed-cap { position: relative; z-index: 3; background: var(--bg); margin: calc(var(--peek) + 18px) 0 0; padding-left: 12px; border-left: 2px solid var(--accent); font-family: var(--font-head); font-style: italic; font-size: 15px; }

  .ed-band { margin-top: 34px; background: var(--paper2); border-top: 1.5px solid var(--ink); border-bottom: 1px solid var(--rule); }
  .ed-band-grid { display: grid; grid-template-columns: 1fr 1fr; }
  .ed-stat { padding: 20px 16px 20px 0; border-bottom: 1px solid var(--line); }
  .ed-stat:nth-child(odd) { border-right: 1px solid var(--line); }
  .ed-stat:nth-child(even) { padding-left: 16px; }
  .ed-stat:nth-child(n + 3) { border-bottom: 0; }
  .ed-stat .n { font-family: var(--font-head); font-size: 24px; line-height: 1; color: var(--accent); margin-bottom: 6px; letter-spacing: -0.02em; }
  .ed-stat .l { font-size: 12.5px; line-height: 1.4; color: var(--muted); }
  /* A `1fr` track still cannot go below its content's longest word, so two
     columns have a hard floor of 357px — set by the Ukrainian band, whose
     figures are words ("Рекомендують", "Засновниця") rather than numbers.
     Below that the band pushed the whole page sideways, so it becomes one
     column: four ruled rows, which is the same device with more room to read.
     The nth-child paddings and rules are undone explicitly — `:nth-child()`
     outranks a plain `.ed-stat` here. */
  @media (max-width: 359.98px) {
    .ed-band-grid { grid-template-columns: 1fr; }
    .ed-stat, .ed-stat:nth-child(even) { padding: 16px 0; }
    .ed-stat:nth-child(odd) { border-right: 0; }
    .ed-stat:nth-child(n + 3) { border-bottom: 1px solid var(--line); }
    .ed-stat:last-child { border-bottom: 0; }
  }

  .ed-sec { padding: 52px 0 0; }
  .ed-head { display: flex; align-items: center; gap: 12px; padding-top: 8px; border-top: 1.5px solid var(--ink); margin-bottom: 22px; }
  .ed-num { font-family: var(--font-head); font-size: 13px; color: var(--accent); font-weight: 500; }
  /* Sections 01/02/03/05 carry this on an <h2> — they are the section's only
     title, and as <span>s the page ran H1 → H3 with no H2 at all (OPS-146).
     Section 04 keeps a <span>, because it has a real <h2> right below it, so
     there the label is a kicker. Size stays at the kicker step deliberately:
     enlarging the five section heads is a visible change to the front page,
     not a defect fix, so it's left for Lena to call. Margin/size are reset
     because this is now a heading inside a flex row. */
  .ed-name { font-family: var(--font-body); font-size: var(--fs-label); font-weight: 800; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink); margin: 0; line-height: 1.2; }
  .ed-more { margin-left: auto; font-family: var(--font-body); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); white-space: nowrap; }
  .ed-readmore { font-family: var(--font-body); font-size: 11.5px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink); border-bottom: 2px solid var(--accent); padding-bottom: 4px; }

  .ed-free { display: inline-block; font-family: var(--font-body); font-size: 10.5px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bg); background: var(--accent); padding: 6px 12px; margin-bottom: 16px; }
  .ed-tools { border-top: 1px solid var(--rule); }
  .ed-tool { display: flex; gap: 16px; padding: 22px 0; border-bottom: 1px solid var(--line); align-items: flex-start; transition: padding-left 0.22s ease; }
  .ed-tool .idx { font-family: var(--font-head); font-size: 14px; color: var(--accent); padding-top: 4px; flex: none; width: 24px; }
  .ed-tool .body { display: block; }
  /* No opacity here — --muted at 0.75 measured 4.21:1 on 10px text, under the
     4.5:1 AA floor. Full --muted is 7.9:1, and these labels are small enough
     that the weight and letter-spacing already hold them back. */
  .ed-tool .tag { display: block; font-family: var(--font-body); font-size: 10px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 7px; }
  .ed-tool h3 { font-size: 22px; line-height: 1.15; margin-bottom: 6px; }
  .ed-tool p { margin: 0 0 10px; font-size: 14.5px; }
  .ed-tool .go { font-family: var(--font-body); font-size: 11px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }

  .ed-feat { display: block; }
  .ed-feat .ph { aspect-ratio: 4 / 3; background: var(--paper2); overflow: hidden; }
  .ed-feat .ph img { width: 100%; height: 100%; object-fit: cover; }
  .ed-feat .body { padding: 22px 0 0; }
  .ed-feat .cat { font-family: var(--font-body); font-size: 10px; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); }
  .ed-feat h3 { font-size: 28px; line-height: 1.1; margin: 10px 0 12px; letter-spacing: -0.02em; }
  .ed-feat p { font-family: var(--font-head); font-size: 17px; font-weight: 300; line-height: 1.5; margin: 0 0 14px; }
  .ed-feat .meta { font-family: var(--font-body); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.8; margin-bottom: 16px; }

  .ed-rec { display: block; position: relative; }
  .ed-rec .ph { position: relative; z-index: 2; aspect-ratio: 1 / 1; overflow: hidden; background: var(--paper2); }
  /* the plate shot has a lot of empty rim — zoom to the food */
  .ed-rec .ph img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.15); }
  .ed-rec .gi { position: absolute; right: 0; top: -10px; z-index: 3; background: var(--ink); color: var(--bg); padding: 14px 16px; text-align: center; }
  .ed-rec .gi b { display: block; font-family: var(--font-head); font-size: 26px; line-height: 1; }
  .ed-rec .gi span { font-family: var(--font-body); font-size: 9.5px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.75; }
  .ed-rec .body { padding: 20px 0 0; }
  .ed-rec h3 { font-size: 26px; line-height: 1.12; margin: 8px 0 10px; }
  .ed-rec p { margin: 0 0 14px; font-size: 15.5px; }
  .ed-docline { margin: 18px 0 0; padding-top: 16px; border-top: 1px solid var(--rule); font-family: var(--font-head); font-style: italic; font-size: 16.5px; color: var(--ink); }
  .ed-docline span { display: block; margin-top: 7px; font-family: var(--font-body); font-style: normal; font-size: 10.5px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }

  .ed-voices { margin-top: 56px; padding: 44px 0 40px; background: var(--ink); color: #E6D9E2; position: relative; overflow: hidden; }
  .ed-voices::before { content: ''; position: absolute; left: -60px; top: -60px; width: 260px; height: 260px; border-radius: 50%; background: radial-gradient(circle, rgba(178, 58, 99, 0.4), transparent 68%); }
  .ed-voices .wrap { position: relative; }
  .ed-voices .ed-head { border-top-color: rgba(255, 255, 255, 0.5); }
  .ed-voices .ed-num { color: #EFA9C5; }
  .ed-voices .ed-name { color: #fff; }
  .ed-voices h2 { color: #fff; font-size: 28px; line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 10px; }
  /* Scoped to .ed-voices, not bare .ed-intro: `.ed p` above is (0,1,1) and was
     beating a lone (0,1,0) class, so this paragraph was rendering in --muted on
     the dark band — 1.89:1. With the selector qualified it gets the light tone
     it was always meant to have (8.7:1). Caught by the OPS-270 contrast pass. */
  .ed-voices .ed-intro { font-family: var(--font-head); font-size: 16px; font-weight: 300; color: #C9B2C2; margin: 0 0 30px; }
  .ed-q { margin: 0; padding: 26px 0; border-top: 1px solid rgba(255, 255, 255, 0.16); }
  .ed-q:first-of-type { border-top: 0; padding-top: 0; }
  .ed-q p { font-family: var(--font-head); font-weight: 300; font-style: italic; font-size: 20px; line-height: 1.42; color: #F4E9F0; margin: 0 0 14px; letter-spacing: -0.01em; }
  .ed-q .hl { font-style: normal; font-weight: 500; color: #fff; box-shadow: inset 0 -0.45em 0 rgba(178, 58, 99, 0.55); }
  .ed-q cite { font-style: normal; font-family: var(--font-body); font-size: 10.5px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: #B79EB0; }
  .ed-clin { margin-top: 30px; padding: 22px; border: 1px solid rgba(255, 255, 255, 0.22); }
  .ed-clin .k { display: block; margin-bottom: 12px; font-family: var(--font-body); font-size: 9.5px; font-weight: 800; letter-spacing: 0.22em; text-transform: uppercase; color: #E0A9C0; }
  .ed-clin .cq { font-family: var(--font-head); font-style: italic; font-size: 19px; line-height: 1.35; color: #fff; margin: 0; }
  .ed-clin .cw { margin: 10px 0 0; font-family: var(--font-body); font-size: 10.5px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: #B79EB0; }

  .ed-rows { border-top: 1px solid var(--rule); }
  .ed-row { display: flex; gap: 16px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  /* 0.75, not the 0.35 this started at: opacity multiplies the magenta against
     the paper, and at 0.35 these numerals measured 1.68:1 where large text
     needs 3:1. 0.75 gives 3.29:1 and matches .ab-row .n on About. */
  .ed-row .n { font-family: var(--font-head); font-size: 30px; line-height: 0.9; color: var(--accent); opacity: 0.75; flex: none; width: 44px; letter-spacing: -0.03em; }
  .ed-row h3 { font-size: 20px; margin-bottom: 5px; }
  .ed-row p { margin: 0; font-size: 14.5px; }


---
// Recipe hub — the editorial system (OPS-275).
//
// Server-rendered card grid + Type/Diet filters + Load more. Cards carry
// data-cat / data-diet; the inline script only shows/hides them (no client
// rendering, no language toggle — language is fixed by the URL).
//
// LAYOUT. Food photography is the draw on this page, so the pictures stay
// larger than anywhere else on the site: square, three across at full width,
// sitting on a paper well with the caption underneath rather than inside card
// chrome. The GI figure moves onto the photograph as the homepage's ink
// plaque — it is the number the whole section exists for. Filters become text
// with an active underline (blog hub), each group on its own labelled hairline
// row so it stays clear that Type and Diet narrow together.
import { PUBLISHED } from '../data/recipes.js';
import { CAT_HUB } from '../data/recipes-lib.js';
import '../styles/recipes.css';

const { lang = 'en' } = Astro.props;
const B = import.meta.env.BASE_URL;
// EN⇄UA counterpart of this hub, and the param that triggers a hop to it
// (old lenafilatova.com redirects append ?lang=ua).
const altHubHref = lang === 'ua' ? `${B}recipes/` : `${B}ua/recipes/`;
const otherLang = lang === 'ua' ? 'en' : 'ua';
const R = lang === 'ua' ? `${B}ua/recipes/` : `${B}recipes/`;
const IMG = `${B}recipes/images/`;

// Hand-picked recipes to lead the hub, in this exact order; everything else
// follows in its original (unsorted) data order.
const FEATURED_SLUGS = [
  'pear-courgette-salad', 'strawberry-white-chocolate-tartlets', 'zucchini-spaghetti-salmon',
  'broccoli-spinach-cream-soup', 'blueberry-jam', 'lemon-thyme-cookies', 'cornmeal-syrniki',
  'ratatouille-yellow-tomatoes', 'summer-berry-pie',
];
const featuredSet = new Set(FEATURED_SLUGS);
const orderedRecipes = [
  ...FEATURED_SLUGS.map((slug) => PUBLISHED.find((r) => r.slug === slug)).filter(Boolean),
  ...PUBLISHED.filter((r) => !featuredSet.has(r.slug)),
];

/* --- landing-page copy (OPS-319) -------------------------------------------
   This hub is the page best qualified to win "low GI recipes UK" and it was
   sitting at position 52 as a bare grid: the plaque on every photograph was
   never explained, and there was no crawlable route into a course. The two
   editorial blocks below fix that. Every figure quoted in the prose is computed
   from the data, so the copy cannot outlive the recipes it describes. */
const giValues = PUBLISHED.map((r) => r.gi).filter((g) => typeof g === 'number');
const giLow = giValues.filter((g) => g <= 55).length;
const giMax = Math.max(...giValues);
const nCat = (v) => PUBLISHED.filter((r) => r.cat === v).length;
const nDiet = (v) => PUBLISHED.filter((r) => (r.tags || []).includes(v)).length;

/* Each collection is a real <a> carrying its filter as a query parameter; the
   inline script at the foot reads the parameter back and presses the matching
   chip. BaseLayout pins the canonical to /recipes/, so ?type=... can never be
   indexed as a second copy of the hub. */
const COLLECTIONS = [
  { g: 'type', v: 'breakfast', n: nCat('breakfast'),
    en: ['Low-GI breakfasts', 'Syrniki, oat pancakes, overnight oats and green smoothies.'],
    ua: ['Сніданки з низьким ГІ', 'Сирники, вівсяні млинці, нічна вівсянка та зелені смузі.'] },
  { g: 'type', v: 'main', n: nCat('main'),
    en: ['Low-GI mains', 'Soups, bakes and one-pan dinners built on protein and non-starchy veg.'],
    ua: ['Основні страви з низьким ГІ', 'Супи, запіканки та вечері на основі білка й некрохмалистих овочів.'] },
  { g: 'type', v: 'baking', n: nCat('baking'),
    en: ['Low-GI baking', 'Cakes, muffins, kulich and stollen made without refined sugar.'],
    ua: ['Випічка з низьким ГІ', 'Торти, мафіни, паски та штолен без рафінованого цукру.'] },
  { g: 'type', v: 'dessert', n: nCat('dessert'),
    en: ['Low-GI desserts', 'Cheesecakes, ice creams and curd cakes — the largest group here.'],
    ua: ['Десерти з низьким ГІ', 'Чізкейки, морозиво та сирні торти — найбільша добірка.'] },
  { g: 'type', v: 'snack', n: nCat('snack'),
    en: ['Low-GI snacks', 'Flour-free cookies, dried-fruit sweets and beetroot crisps.'],
    ua: ['Перекуси з низьким ГІ', 'Печиво без борошна, цукерки із сухофруктів і бурякові чипси.'] },
  { g: 'type', v: 'bread', n: nCat('bread'),
    en: ['Low-GI bread', 'Wholegrain and slow-proved sourdough loaves.'],
    ua: ['Хліб з низьким ГІ', 'Цільнозерновий і заквасковий хліб довгого бродіння.'] },
  { g: 'type', v: 'sauce', n: nCat('sauce'),
    en: ['Jams and sauces', 'Chia jams and rhubarb preserves set without sugar.'],
    ua: ['Джеми та соуси', 'Джеми з чіа та ревеню, зварені без цукру.'] },
  { g: 'diet', v: 'sugar-free', n: nDiet('sugar-free'),
    en: ['Sugar-free recipes', 'Sweetened with erythritol, stevia or a little honey — never refined sugar.'],
    ua: ['Рецепти без цукру', 'З еритритолом, стевією або трохи меду — без рафінованого цукру.'] },
  { g: 'diet', v: 'low-carb', n: nDiet('low-carb'),
    en: ['Low-carb recipes', 'The smallest carbohydrate load per portion.'],
    ua: ['Низьковуглеводні рецепти', 'Найменше вуглеводів на порцію.'] },
  { g: 'diet', v: 'gluten-free', n: nDiet('gluten-free'),
    en: ['Gluten-free recipes', 'Built on ground almonds, buckwheat and coconut flour.'],
    ua: ['Рецепти без глютену', 'На мигдалевому, гречаному та кокосовому борошні.'] },
  { g: 'diet', v: 'dairy-free', n: nDiet('dairy-free'),
    en: ['Dairy-free recipes', 'Made without milk, cream or cottage cheese.'],
    ua: ['Рецепти без молочного', 'Приготовані без молока, вершків і сиру.'] },
  { g: 'diet', v: 'vegetarian', n: nDiet('vegetarian'),
    en: ['Vegetarian recipes', 'No meat or fish.'],
    ua: ['Вегетаріанські рецепти', 'Без м’яса та риби.'] },
];
// #filters lands the visitor on the grid rather than the intro. The fragment
// does the scrolling, not script: an on-load scrollIntoView loses the race with
// the browser's own scroll restoration and silently leaves you at the top.
const collHref = (c) => `${R}?${c.g}=${c.v}#filters`;

// The "Load more" batching below is JS-only, so without these two constants the
// server ships all ~86 cards visible and the browser pulls ~10 MB of thumbnails
// before the inline script gets a chance to hide anything.
//
// INITIAL matches the largest first batch the script can choose (batchSize() is
// columns x 3 rows, and the grid tops out around 4 columns), so pre-hiding past
// it never takes away a card the script would have shown — no visible reflow.
// Cards past it are display:none, and a lazy <img> inside display:none is never
// fetched.
const INITIAL = 18;
// The first row is what the visitor actually looks at. `lazy` keeps those out of
// the preload scanner and queues them at Low priority behind everything else,
// which is what left them as empty gradient boxes.
const EAGER = 4;

const TYPE_CHIPS = [
  { v: 'breakfast', en: 'Breakfast', ua: 'Сніданки' }, { v: 'main', en: 'Mains', ua: 'Основні' },
  { v: 'dessert', en: 'Desserts', ua: 'Десерти' }, { v: 'baking', en: 'Baking', ua: 'Випічка' },
  { v: 'snack', en: 'Snacks', ua: 'Перекуси' }, { v: 'bread', en: 'Bread', ua: 'Хліб' },
  { v: 'sauce', en: 'Sauces', ua: 'Соуси' }, { v: 'drink', en: 'Drinks', ua: 'Напої' },
];
const DIET_CHIPS = [
  { v: 'sugar-free', en: 'Sugar-free', ua: 'Без цукру' }, { v: 'gluten-free', en: 'Gluten-free', ua: 'Без глютену' },
  { v: 'low-carb', en: 'Low carb', ua: 'Низьковуглеводне' }, { v: 'vegetarian', en: 'Vegetarian', ua: 'Вегетаріанське' },
  { v: 'dairy-free', en: 'Dairy-free', ua: 'Без молочного' },
];

function recipeWord(n) {
  if (lang === 'en') return n === 1 ? 'recipe' : 'recipes';
  const a = n % 10, b = n % 100;
  return n === 0 ? 'рецептів' : (a === 1 && b !== 11) ? 'рецепт' : (a >= 2 && a <= 4 && (b < 12 || b > 14)) ? 'рецепти' : 'рецептів';
}

const T = {
  eyebrow: lang === 'ua' ? 'Рецепти з низьким ГІ' : 'Low-GI Recipes',
  h1: lang === 'ua' ? 'Рецепти з низьким ГІ' : 'Low-GI recipes',
  lede: lang === 'ua'
    ? `Страви, дружні до рівня цукру в крові, для жінок 40+ — випічка без цукру, низьковуглеводні страви, сніданки й десерти, кожен з оціненим ГІ на картці. Українською та англійською; будь-який рецепт можна додати до спільного списку покупок.`
    : `Blood-sugar-friendly recipes for women 40+ — sugar-free bakes, low-carb mains, breakfasts and desserts, each with an estimated GI on the card. Written in the UK, in English and Ukrainian; add any recipe to one combined shopping list.`,

  // GI explainer. The plaque is the number the whole section exists for and
  // nothing on the page said what it was.
  giH: lang === 'ua' ? 'Що означає число на кожному фото' : 'What the number on each photograph means',
  giP: lang === 'ua'
    ? `Табличка в кутку кожної картки — це оцінений глікемічний індекс рецепта: наскільки швидко вуглеводи однієї порції піднімають рівень глюкози в крові за шкалою, де чиста глюкоза дорівнює 100. Із ${PUBLISHED.length} рецептів тут ${giLow} мають 55 або менше, і жоден не піднімається вище ${giMax}.`
    : `The plaque in the corner of every card is that recipe's estimated glycaemic index — how quickly the carbohydrate in one portion tends to lift blood glucose, on a scale where pure glucose is 100. Of the ${PUBLISHED.length} recipes here, ${giLow} come in at 55 or under, and none goes above ${giMax}.`,
  giBands: lang === 'ua'
    ? [['0–55', 'Низький', 'Повільне, рівне підвищення.'], ['56–69', 'Середній', 'Помірне підвищення.'], ['70+', 'Високий', 'Швидкий стрибок — таких тут немає.']]
    : [['0–55', 'Low', 'A slow, steady rise.'], ['56–69', 'Medium', 'A moderate rise.'], ['70+', 'High', 'A fast spike — nothing on this page sits here.']],
  giFineA: lang === 'ua'
    ? 'Це оцінки для рецепта в тому вигляді, як він написаний, а не лабораторні виміри: розмір порції, стиглість продуктів і те, що ви їсте разом, змінюють реальне число. Показники для окремих продуктів — у '
    : 'These are estimates for the recipe as written, not laboratory measurements: portion size, ripeness and what you eat alongside all move the real number. The per-ingredient figures are in the ',
  giFineLink: lang === 'ua' ? 'таблиці вуглеводів і ГІ' : 'carb & GI table',
  giFineB: lang === 'ua' ? '.' : '.',

  // Crawlable entry points into the grid, below the fold.
  collH: lang === 'ua' ? 'Добірки рецептів з низьким ГІ' : 'Browse the low-GI recipes',
  collCourse: lang === 'ua' ? 'За типом страви' : 'By course',
  collDiet: lang === 'ua' ? 'За дієтою' : 'By diet',

  ukH: lang === 'ua' ? 'Про міри та інгредієнти' : 'Cooking these in a UK kitchen',
  ukP1: lang === 'ua'
    ? 'Температури духовки вказані в °C. Підсолоджувачі — еритритол, ксиліт і стевія; мигдалеве, гречане й лляне борошно та цільнозернове пшеничне борошно теж є у звичайних магазинах.'
    : 'These are written and cooked in the UK, so oven temperatures are in °C and the sweeteners are the ones British supermarkets and health-food shops actually stock — erythritol, xylitol and stevia. Ground almonds, flaxseed and wholegrain wheat flour are ordinary shelf items here too.',
  ukP2: lang === 'ua'
    ? 'Частина рецептів прийшла з lenafilatova.com і досі використовує американські «cup». Одна чашка — це 240 мл, тож мірний глечик цілком підходить.'
    : 'Many of the recipes were first written for lenafilatova.com and still carry American cup measures. One cup is 240 ml, which an ordinary measuring jug covers.',
  typeLabel: lang === 'ua' ? 'Тип' : 'Type',
  dietLabel: lang === 'ua' ? 'Дієта' : 'Diet',
  clear: lang === 'ua' ? 'Скинути фільтри' : 'Clear filters',
  more: lang === 'ua' ? 'Показати ще' : 'Load more',
  emptyH: lang === 'ua' ? 'Немає рецептів за цими фільтрами' : 'No recipes match those filters',
  emptyP: lang === 'ua' ? 'Спробуйте прибрати один фільтр.' : 'Try removing one to see more.',
  foot: lang === 'ua'
    ? 'Рецепти адаптовано з lenafilatova.com. Примітки щодо ГІ мають загальний характер і не замінюють медичну чи дієтичну консультацію.'
    : 'Recipes adapted from lenafilatova.com. GI notes are for general guidance, not personalised medical or dietary advice.',
};
---
<script is:inline define:vars={{ altHubHref, otherLang }}>
  if (new RegExp('[?&]lang=' + otherLang).test(location.search)) location.replace(altHubHref);
</script>

<div class="rx">
  <section class="rx-hub-head">
    <div class="wrap">
      {/* Label + hairline rule, the masthead device the homepage and blog use. */}
      <p class="est"><span class="est-label">{T.eyebrow}</span><span class="est-rule"></span></p>
      <div class="head">
        <h1>{T.h1}</h1>
        <p class="lede">{T.lede}</p>
      </div>

      {/* The GI plaque sits on all 86 photographs and nothing explained it. */}
      <section class="rx-gi-note">
        <h2>{T.giH}</h2>
        <p>{T.giP}</p>
        <div class="rx-gi-bands">
          {T.giBands.map(([range, name, desc]) => (
            <div>
              <span class="band-range">{range}</span>
              <span class="band-name">{name}</span>
              <span class="band-desc">{desc}</span>
            </div>
          ))}
        </div>
        <p class="fine">{T.giFineA}<a href={lang === 'ua' ? `${B}carb-gi-table-ua/` : `${B}carb-gi-table/`}>{T.giFineLink}</a>{T.giFineB}</p>
      </section>
    </div>
  </section>

  <div class="wrap">
    <div class="rx-filters" id="filters">
      <div class="filter-row">
        <span class="filter-label" id="flt-type">{T.typeLabel}</span>
        <div class="chips" role="group" aria-labelledby="flt-type">
          {TYPE_CHIPS.map((c) => (
            <button class="chip" type="button" aria-pressed="false" data-group="cat" data-value={c.v}>{lang === 'ua' ? c.ua : c.en}</button>
          ))}
        </div>
      </div>
      <div class="filter-row">
        <span class="filter-label" id="flt-diet">{T.dietLabel}</span>
        <div class="chips" role="group" aria-labelledby="flt-diet">
          {DIET_CHIPS.map((c) => (
            <button class="chip" type="button" aria-pressed="false" data-group="diet" data-value={c.v}>{lang === 'ua' ? c.ua : c.en}</button>
          ))}
        </div>
      </div>
    </div>

    <div class="bar2">
      <div class="count"><b id="countNum">{PUBLISHED.length}</b> <span id="countWord">{recipeWord(PUBLISHED.length)}</span></div>
      <button class="clear" id="clearBtn" disabled>{T.clear}</button>
    </div>

    <div class="cards" id="grid">
      {orderedRecipes.map((r, i) => (
        <a class={`rcard${i >= INITIAL ? ' hidden' : ''}`} href={`${R}${r.slug}/`} data-cat={r.cat} data-diet={(r.tags || []).join(' ')}>
          <div class="thumb">
            <img src={`${IMG}${r.img}`} loading={i < EAGER ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" alt={r.title[lang]} />
            {typeof r.gi === 'number' && <span class="gi-plaque"><b>{r.gi}</b><span>GI</span></span>}
          </div>
          <div class="body">
            <div class="title">{r.title[lang]}</div>
            <div class="cmeta"><span>{CAT_HUB[r.cat][lang]}</span><span>{r.meta.serves[lang]}</span></div>
          </div>
        </a>
      ))}
    </div>

    {/* Without JS nothing ever calls apply(), so the pre-hidden cards would stay
        hidden and "Load more" (display:none until the script shows it) could not
        bring them back. Give those visitors the whole grid instead — as flex,
        which is what the card layout is. */}
    <noscript><style>.rx .cards .rcard.hidden { display: flex; }</style></noscript>

    <div class="more-wrap" id="moreWrap"><button class="more-btn" id="moreBtn">{T.more}</button></div>
    <div class="empty" id="empty">
      <h3>{T.emptyH}</h3>
      <p>{T.emptyP}</p>
    </div>

    <section class="rx-collections">
      <h2>{T.collH}</h2>
      {[[T.collCourse, 'type'], [T.collDiet, 'diet']].map(([label, group]) => (
        <div class="rx-coll-group">
          <span class="fk">{label}</span>
          <div class="rx-coll-list">
            {COLLECTIONS.filter((c) => c.g === group).map((c) => (
              <a href={collHref(c)}>
                <span class="cn">{c[lang][0]}</span><span class="cc">{c.n}</span>
                <span class="cd">{c[lang][1]}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="rx-uk-note">
      <h2>{T.ukH}</h2>
      <p>{T.ukP1}</p>
      <p>{T.ukP2}</p>
    </section>

    <p class="foot-note">{T.foot}</p>
  </div>
</div>

<script define:vars={{ lang }}>
  (function () {
    var chips = [].slice.call(document.querySelectorAll('.chip'));
    var grid = document.getElementById('grid');
    var clearBtn = document.getElementById('clearBtn'), empty = document.getElementById('empty');
    var moreWrap = document.getElementById('moreWrap'), moreBtn = document.getElementById('moreBtn');
    var batchesShown = 1;

    function perRow() {
      var cols = getComputedStyle(grid).gridTemplateColumns;
      var n = (cols || '').split(' ').filter(Boolean).length;
      return n > 0 ? n : 1;
    }
    function batchSize() { var c = perRow(); var rows = c >= 3 ? 3 : (c === 2 ? 4 : 6); return c * rows; }
    function recipeWord(n) {
      if (lang === 'en') return n === 1 ? 'recipe' : 'recipes';
      var a = n % 10, b = n % 100;
      return n === 0 ? 'рецептів' : (a === 1 && b !== 11) ? 'рецепт' : (a >= 2 && a <= 4 && (b < 12 || b > 14)) ? 'рецепти' : 'рецептів';
    }
    function groups() {
      var g = {};
      chips.forEach(function (c) { if (!c.classList.contains('active')) return; var k = c.getAttribute('data-group'); (g[k] = g[k] || []).push(c.getAttribute('data-value')); });
      return g;
    }
    function apply() {
      var g = groups(), any = Object.keys(g).length > 0, total = 0;
      var step = batchSize(), limit = step * batchesShown;
      [].slice.call(grid.querySelectorAll('.rcard')).forEach(function (card) {
        var ok = Object.keys(g).every(function (k) {
          var have = (card.getAttribute('data-' + k) || '').split(' ');
          return g[k].some(function (v) { return have.indexOf(v) !== -1; });
        });
        if (ok) { card.classList.toggle('hidden', total >= limit); total++; }
        else { card.classList.add('hidden'); }
      });
      document.getElementById('countNum').textContent = total;
      document.getElementById('countWord').textContent = recipeWord(total);
      empty.classList.toggle('show', total === 0);
      clearBtn.disabled = !any;
      var remaining = total - limit, next = Math.min(step, remaining);
      moreWrap.classList.toggle('show', remaining > 0);
      if (remaining > 0) moreBtn.textContent = (lang === 'ua' ? 'Показати ще ' + next : 'Load ' + next + ' more');
    }
    function reset() { batchesShown = 1; apply(); }
    // .active is the visual state; aria-pressed is the same state for assistive
    // tech. Set both together so a screen reader never disagrees with the paint.
    function setChip(c, on) { c.classList.toggle('active', on); c.setAttribute('aria-pressed', on ? 'true' : 'false'); }
    chips.forEach(function (c) { c.addEventListener('click', function () { setChip(c, !c.classList.contains('active')); reset(); }); });
    clearBtn.addEventListener('click', function () { chips.forEach(function (c) { setChip(c, false); }); reset(); });
    moreBtn.addEventListener('click', function () { batchesShown++; apply(); });
    var rt; window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(apply, 150); });

    // The collection links under the grid are real URLs carrying their filter
    // as ?type=/?diet= — press the matching chips before the first apply() so
    // the visitor lands on the filtered grid rather than the whole 86. The
    // links also carry #filters, which is what does the scrolling. Multiple
    // values of one parameter are allowed: they OR within their group, exactly
    // as pressing two chips does.
    var qs = new URLSearchParams(location.search);
    var want = { cat: qs.getAll('type'), diet: qs.getAll('diet') };
    chips.forEach(function (ch) {
      var g = ch.getAttribute('data-group');
      if (want[g] && want[g].indexOf(ch.getAttribute('data-value')) !== -1) setChip(ch, true);
    });
    apply();
  })();
</script>

<script is:inline define:vars={{ lang }}>window.LF_LANG = lang;</script>
<script is:inline src={`${B}recipes.js`}></script>

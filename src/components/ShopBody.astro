---
// Shop — the editorial system (OPS-277).
//
// Was: three rounded cards in a grid with a pill "Coming soon" badge, and a
// closing note telling people to leave their email *on the contact page*. The
// homepage now promises that newsletter subscribers get first access and
// founding prices, so the two pages disagreed about how you actually get told.
//
// Now: the numbered editorial index the resources hub and homepage use, and the
// waitlist promise stated in the homepage's words. "Join the waitlist" points at
// #newsletter — the signup BaseLayout already puts above the footer of every
// page — so the CTA lands on the form it names instead of sending the visitor
// to the contact page to find a different one.
//
// Still no cart, prices or checkout: nothing is on sale yet (see shop.js).
import { SHOP } from '../data/shop.js';
import Picture from './Picture.astro';

const { lang = 'en' } = Astro.props;
const t = SHOP[lang];
const B = import.meta.env.BASE_URL;
const L = lang === 'ua' ? `${B}ua/` : B;
const img = (src) => B.replace(/\/$/, '') + src;
// .sh-item is a 0.9fr / 1.1fr split of the 1072px content width.
const SHOP_SIZES = '(min-width: 1000px) 460px, calc(100vw - 48px)';
---
<section class="sh-head">
  <div class="wrap">
    <p class="est"><span class="est-label">{t.kicker}</span><span class="est-rule"></span></p>
    <div class="head">
      <h1>{t.h1}</h1>
      <p class="lede">{t.lead}</p>
    </div>
    {/* The waitlist promise, in the homepage's words. It sits up here rather
        than as a footnote at the bottom: on a page where nothing is buyable
        yet, it is the only thing a visitor can act on. */}
    <p class="sh-note">{t.note}</p>
  </div>
</section>

<section class="sh-wrap">
  <div class="wrap">
    <div class="sh-sec-head">
      <span class="fk">{t.kicker}</span>
      <span class="fk-n">{String(t.items.length).padStart(2, '0')}</span>
    </div>
    <ol class="sh-list">
      {t.items.map((p, i) => (
        <li class="sh-item">
          <div class="sh-ph">
            <Picture src={SHOP.imgs[i]} alt={p.title} sizes={SHOP_SIZES} loading="lazy" />
            {!p.available && <span class="sh-soon">{t.soon}</span>}
          </div>
          <div class="sh-body">
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <span class="sh-tag">{p.tag}</span>
              <h2>{p.title}</h2>
              <p class="sh-desc">{p.body}</p>
              <p class="sh-format">{p.format}</p>
              <ul class="sh-inside">
                {p.inside.map((li) => <li>{li}</li>)}
              </ul>
              {/* The live offering points at coaching; the two unbuilt ones point
                  at the newsletter above the footer of this same page. */}
              {p.available
                ? <a class="btn" href={`${L}contact/`}>{t.coachCta}</a>
                : <a class="btn ghost" href="#newsletter">{t.notify}</a>}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

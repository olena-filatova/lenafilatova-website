---
// Blog index — the editorial system (OPS-274).
//
// Server-rendered, newest first, with category filters (cards carry data-cats;
// the inline script only shows/hides, it never renders content). NEW vs the
// Divhunt site: the old blog had no filtering; categories were display-only.
//
// LAYOUT. The ticket asked for "a larger lead post and a list beneath rather
// than a uniform grid". The lead already exists as the featured band, so that
// is what carries it: posts flagged `featured: true` in blog.js (max 3) sit
// above the filters as one large editorial feature — square photo beside the
// headline — plus hairline rows when more than one is flagged. Below it the
// grid keeps three columns on desktop (39 posts in one column would be a very
// long page) but loses all card chrome, and collapses to a genuine ruled list
// of thumb-left rows on a phone, where most of the reading happens.
//
// The band appears only on the "All" view; picking a category hides it and the
// featured posts rejoin the grid, so a filtered view is always complete.
import { POSTS } from '../data/blog.js';
import { CATS, UI, featuredPosts, warnAssetGaps } from '../data/blog-lib.js';
import DIMS from '../data/image-dims.json';
import '../styles/blog.css';

const { lang = 'en' } = Astro.props;
// Sort by date so a post appended to the data file still lands on top.
// `filedUnder: 'tools'` posts are listed on the Tools & guides page instead of
// here (OPS-290) — they keep their /blog/ URL, they just aren't Journal entries.
const sorted = [...POSTS]
  .filter((p) => p.filedUnder !== 'tools')
  .sort((a, b) => b.date.localeCompare(a.date));
// Selection + the build-time staleness warning live in blog-lib.js (OPS-299).
// `sorted` is date-descending, so the newest flagged post becomes the lead card.
const featured = featuredPosts(sorted);
// Hero-image and imageAlt gaps are silent otherwise (OPS-360). Warns once per
// build even though this component renders for both languages.
warnAssetGaps(POSTS, DIMS);
const [lead, ...minis] = featured;
const t = UI[lang];
const B = import.meta.env.BASE_URL;
const hub = lang === 'ua' ? `${B}ua/blog/` : `${B}blog/`;
const img = (src) => B.replace(/\/$/, '') + src;
// Intrinsic dimensions where we have them (see BlogPostBody) — a missing entry
// just omits the attributes; the aspect-ratio on the well already holds the box.
const dim = (src) => DIMS[src] || {};
---
<section class="blog-hero">
  <div class="wrap">
    {/* Label + hairline rule, the same masthead device the homepage hero uses. */}
    <p class="est"><span class="est-label">{t.hubKicker}</span><span class="est-rule"></span></p>
    <div class="head">
      <h1>{t.hubH1}</h1>
      <p class="lede">{t.hubLead}</p>
    </div>
  </div>
</section>

{lead && (
  <section class="featured" id="blogFeatured">
    <div class="wrap">
      <div class="hub-head"><span class="fk">{t.featured}</span></div>
      <div class={`featured-grid${minis.length ? '' : ' solo'}`}>
        <a class="flead" href={`${hub}${lead.slug}/`}>
          <div class="ph">
            <img
              src={img(lead.image)}
              alt=""
              fetchpriority="high"
              decoding="async"
              width={dim(lead.image).w}
              height={dim(lead.image).h}
            />
          </div>
          <div class="body">
            <p class="cat">{lead[lang].cat}</p>
            <h2>{lead[lang].title}</h2>
            <p class="excerpt">{lead[lang].excerpt}</p>
            <p class="meta">{lead[lang].meta}</p>
          </div>
        </a>
        {/* `fill` makes the rows share the lead's height instead of stopping
            short and leaving a void down the right (OPS-299 follow-up). Only
            from two rows up: a single row stretched to the lead's full height
            looks marooned, which is worse than the gap it fixes. */}
        {minis.length > 0 && (
          <div class={`fside${minis.length >= 2 ? ' fill' : ''}`}>
            {minis.map((p) => (
              <a class="fmini" href={`${hub}${p.slug}/`}>
                <span class="thumb">
                  <img src={img(p.image)} alt="" loading="lazy" decoding="async" />
                </span>
                <span class="body">
                  <span class="cat">{p[lang].cat}</span>
                  <h3>{p[lang].title}</h3>
                  <span class="meta">{p[lang].meta}</span>
                </span>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
)}

<section>
  <div class="wrap">
    {/* Section label and filters share one ruled bar: the filters ARE the
        section's heading on a filtered view, so stacking them under a separate
        rule only added a line. The label follows the selection (see script). */}
    <div class="hub-bar">
      <span class="fk" id="blogGridLabel" data-all={t.latest}>{t.latest}</span>
      <div class="blog-filters" id="blogFilters" role="group" aria-label={t.hubKicker}>
        <button class="chip on" type="button" data-cat="all" aria-pressed="true">{t.all}</button>
        {CATS.map((c) => (
          <button class="chip" type="button" data-cat={c.key} aria-pressed="false">{c[lang]}</button>
        ))}
      </div>
    </div>
    <div class="blog-grid" id="blogGrid">
      {sorted.map((p) => (
        <a
          class={`bcard${featured.includes(p) ? ' hidden' : ''}`}
          href={`${hub}${p.slug}/`}
          data-cats={p.cats.join(' ')}
          data-featured={featured.includes(p) ? '1' : undefined}>
          <div class="thumb">
            <img src={img(p.image)} alt="" loading="lazy" decoding="async" />
            {p.comingSoon && <span class="soon">{t.comingSoonBadge}</span>}
          </div>
          <div class="body">
            <p class="cat">{p[lang].cat}</p>
            <h2>{p[lang].title}</h2>
            <p class="excerpt">{p[lang].excerpt}</p>
            <p class="meta">{p[lang].meta}</p>
          </div>
        </a>
      ))}
    </div>
    <p class="blog-empty" id="blogEmpty">{t.empty}</p>
  </div>
</section>

<script>
  (function () {
    var filters = document.getElementById('blogFilters');
    var grid = document.getElementById('blogGrid');
    var empty = document.getElementById('blogEmpty');
    var band = document.getElementById('blogFeatured');
    var label = document.getElementById('blogGridLabel');
    if (!filters || !grid) return;
    function apply(btn) {
      [].slice.call(filters.querySelectorAll('.chip')).forEach(function (c) {
        var on = c === btn;
        c.classList.toggle('on', on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      var want = btn.getAttribute('data-cat');
      var all = want === 'all';
      // Featured band only makes sense on the unfiltered view; on a category
      // view the featured posts show as ordinary grid cards instead.
      if (band) band.style.display = all ? '' : 'none';
      // The label names what is below it: "Latest" unfiltered, otherwise the
      // category — taken from the button so it stays in the page's language.
      if (label) label.textContent = all ? label.getAttribute('data-all') : btn.textContent;
      var shown = 0;
      [].slice.call(grid.querySelectorAll('.bcard')).forEach(function (card) {
        var inBand = all && band && card.hasAttribute('data-featured');
        var ok = !inBand && (all || (card.getAttribute('data-cats') || '').split(' ').indexOf(want) >= 0);
        card.classList.toggle('hidden', !ok);
        if (ok) shown++;
      });
      if (empty) empty.style.display = shown || (all && band) ? 'none' : 'block';
    }
    filters.addEventListener('click', function (e) {
      var btn = e.target.closest('.chip');
      if (btn) apply(btn);
    });
    // Deep link: /blog/?cat=nutrition pre-selects a chip (footer category links).
    var want = new URLSearchParams(window.location.search).get('cat');
    // Digits are allowed in the class: the `glp1` key (OPS-356) is the first
    // category with a number in it, and an [^a-z-] scrub silently turned it
    // into `glp`, which matches no chip and left ?cat=glp1 showing everything.
    var pre = want && filters.querySelector('.chip[data-cat="' + want.replace(/[^a-z0-9-]/g, '') + '"]');
    if (pre) apply(pre);
  })();
</script>
